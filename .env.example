# mock = localStorage (development), api = Xplore NestJS backend (Phase B)
NEXT_PUBLIC_LABS_BRIDGE=mock
# Xplore NestJS URL, only used when NEXT_PUBLIC_LABS_BRIDGE=api
NEXT_PUBLIC_LABS_API_URL=
# Optional. Read-only GitHub token (fine-grained, "Metadata: read" on this repo): lets the
# footer list the repo's contributors as developers. Without it, the footer shows a fallback.
GITHUB_TOKEN=
# Optional. Where the "Your feedback" button leads (a form or an Xplore page); hidden if empty.
NEXT_PUBLIC_FEEDBACK_URL=
