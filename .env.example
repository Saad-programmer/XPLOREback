# mock = localStorage, api = Xplore NestJS backend, supabase = Labs Supabase backend
NEXT_PUBLIC_LABS_BRIDGE=mock
# Supabase project values. Keep both database URLs server-side; never prefix with NEXT_PUBLIC_.
DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LABS_HMAC_SECRET=
XPLORE_API_URL=
XPLORE_SYNC_SECRET=
LABS_XP_SYNC_SECRET=
LABS_TENANT_ID=
NEXT_PUBLIC_LABS_GAMIFICATION_ENABLED="true"
NEXT_PUBLIC_LABS_DEV_PLAYER_SWITCHER="true"
# Xplore NestJS URL, only used when NEXT_PUBLIC_LABS_BRIDGE=api
NEXT_PUBLIC_LABS_API_URL=
# Optional. Read-only GitHub token (fine-grained, "Metadata: read" on this repo): lets the
# footer list the repo's contributors as developers. Without it, the footer shows a fallback.
GITHUB_TOKEN=
# Optional. Where the "Your feedback" button leads (a form or an Xplore page); hidden if empty.
NEXT_PUBLIC_FEEDBACK_URL=
