.thumb {
  position: relative;
  aspect-ratio: 16 / 10;
  overflow: hidden;
  background:
    radial-gradient(circle at 1px 1px, rgb(169 177 214 / 0.08) 1px, transparent 0) 0 0 / 14px 14px,
    #0a1330;
  color: var(--accent);
}

/* Sneak peek over the capsule art: the art stays visible behind the terminal. */
.thumb[data-overlay] {
  height: 100%;
  aspect-ratio: auto;
  background: rgb(7 14 38 / 0.84);
  backdrop-filter: blur(3px);
}

.term {
  position: absolute;
  inset: 14px 14px auto 14px;
  font-size: 12px;
  line-height: 1.6;
  color: var(--text);
}

.term p {
  margin: 0;
  white-space: nowrap;
  overflow: hidden;
}

.prompt {
  color: #9ece6a;
  font-weight: 700;
}

/* At rest the finished scene shows; hover or focus replays it as a loop. */
.typed,
.typed2 {
  display: inline-block;
  overflow: hidden;
  vertical-align: bottom;
  border-right: 2px solid transparent;
}

.output {
  color: var(--muted);
}

.output2 {
  color: #e0af68;
}

.mascot {
  position: absolute;
  right: 12px;
  bottom: 6px;
  transition: transform 300ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

.icon {
  position: absolute;
  inset: 0;
  margin: auto;
  opacity: 0.85;
  transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
}

:global(.hub-card):hover .typed,
:global(.hub-card):focus-visible .typed {
  animation: typeA 4.8s steps(1) infinite;
}

:global(.hub-card):hover .typed2,
:global(.hub-card):focus-visible .typed2 {
  animation: typeB 4.8s steps(1) infinite;
}

:global(.hub-card):hover .output,
:global(.hub-card):focus-visible .output {
  animation: showA 4.8s steps(1) infinite;
}

:global(.hub-card):hover .output2,
:global(.hub-card):focus-visible .output2 {
  animation: showB 4.8s steps(1) infinite;
}

:global(.hub-card):hover .mascot,
:global(.hub-card):focus-visible .mascot {
  transform: translateY(-4px) rotate(-6deg);
}

:global(.hub-card):hover .icon,
:global(.hub-card):focus-visible .icon {
  transform: scale(1.08);
}

/* ls -a typed letter by letter, then the cat line. */
@keyframes typeA {
  0% {
    width: 0;
    border-color: var(--text);
  }
  5% {
    width: 1ch;
  }
  8% {
    width: 2ch;
  }
  11% {
    width: 3ch;
  }
  14% {
    width: 4ch;
  }
  17%,
  100% {
    width: 5ch;
    border-color: transparent;
  }
}

@keyframes showA {
  0%,
  20% {
    opacity: 0;
  }
  21%,
  100% {
    opacity: 1;
  }
}

@keyframes typeB {
  0%,
  28% {
    width: 0;
    border-color: var(--text);
  }
  32% {
    width: 4ch;
  }
  38% {
    width: 9ch;
  }
  44% {
    width: 14ch;
  }
  50%,
  100% {
    width: 18ch;
    border-color: transparent;
  }
}

@keyframes showB {
  0%,
  54% {
    opacity: 0;
  }
  55%,
  100% {
    opacity: 1;
  }
}

@media (prefers-reduced-motion: reduce) {
  :global(.hub-card) .typed,
  :global(.hub-card) .typed2,
  :global(.hub-card) .output,
  :global(.hub-card) .output2 {
    animation: none !important;
  }
}
