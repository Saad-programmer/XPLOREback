${re}`);return $n.statements.at(-1)?.rows??[]}}const rulesText=`-- The rules of Strategy, as the database runs them.
--
-- This file is not a description of the game. It is the game. The engine loads
-- the \`world\` section once when a campaign starts, runs \`opening\` to set the
-- board, and runs \`tick\` every time you COMMIT. There is no other rulebook and
-- nothing happens that is not written here.
--
-- Four verbs: move, fight, gather, build.
--
--   move    set units.dest_city_id. One road hop per turn, toward the target.
--   fight   two factions in one city, strongest total strength wins, the rest die.
--   gather  a city one faction holds alone adds to its resources every turn.
--   build   queue a unit in a city you hold and pay for it in iron.
--
-- You cannot see the enemy. \`units\` is a view onto \`all_units\` that shows you
-- your own and nothing else, so there is no query that reads an enemy army off
-- the table. What you get instead is \`scouting\`: what your own units saw from
-- where they were standing, written down once a turn. Everything built on
-- \`units\` — city_force, held_city — is fogged the same way, because it is
-- built on the view and not on the table underneath.
--
-- The tick is the exception. It runs as faction 0 and the view shows faction 0
-- everything, which is how combat can resolve a fight neither side can see in
-- full. One rule keeps this straight: the tick writes \`all_units\`, and
-- everybody, tick included, reads \`units\`.
--
-- You can write views of your own, and they last as long as the campaign does.
-- This is the whole point of playing a war in SQL: a question worth asking
-- twice is worth naming once.
--
--   CREATE VIEW front AS
--     SELECT c.name, h.strength FROM held_city h JOIN cities c ON c.id = h.city_id
--      WHERE h.faction_id = 1;
--
-- Your views are fogged like everything else, because they are built on the
-- same views you read. One over \`all_units\` is refused when you read it.


-- @section world

-- What each kind of unit costs, how long it takes, and what it is worth.
-- Read it whenever you like:  SELECT * FROM unit_types;
--
-- Scouts are weak on purpose. What they are for is sight: a city holding one
-- reports enemies two roads away instead of one. See step 5.
CREATE TABLE unit_types (
  type TEXT PRIMARY KEY,
  build_turns INTEGER NOT NULL,
  iron_cost INTEGER NOT NULL,
  strength INTEGER NOT NULL
);
INSERT INTO unit_types (type, build_turns, iron_cost, strength) VALUES
  ('scouts',   1, 10, 10),
  ('infantry', 2, 25, 30),
  ('cavalry',  3, 40, 50);

-- Whose orders the guards below are accepting, and what turn it is.
--
-- faction_id 0 means the tick itself. The world moves under its own rules, so
-- every guard stands aside for faction 0. You can read this table; you cannot
-- write it. That single rule is held by the engine's sandbox rather than by a
-- trigger, because a trigger cannot guard the table it consults.
CREATE TABLE turn_state (
  faction_id INTEGER NOT NULL,
  turn_number INTEGER NOT NULL
);
INSERT INTO turn_state (faction_id, turn_number) VALUES (0, 1);


-- Scratch space for the combat step, which has to know every loss before it
-- takes any. It keeps this turn's dead until the next battle overwrites them,
-- which is where the report after a turn comes from. Temporary, so it is not
-- part of the world you query.
CREATE TEMP TABLE battle_losses (
  unit_id INTEGER PRIMARY KEY,
  city_id INTEGER NOT NULL,
  faction_id INTEGER NOT NULL,
  strength INTEGER NOT NULL
);


-- The armies. \`all_units\` is the real table and nothing reads it by name
-- except the tick: the engine's sandbox refuses to compile a player statement
-- that mentions it, the way it refuses turn_state. A trigger could not do this
-- job — SQLite triggers cannot fire on a SELECT, so hiding rows from a reader
-- has to happen before the statement runs.
ALTER TABLE units RENAME TO all_units;

-- What you can see of the armies: yours. faction 0 is the tick, and the tick
-- sees everything.
CREATE VIEW units AS
  SELECT * FROM all_units
   WHERE (SELECT faction_id FROM turn_state) = 0
      OR faction_id = (SELECT faction_id FROM turn_state);

-- What your units reported, one row per enemy force per city per turn. This is
-- Seek inside the war: the enemy is a trail of sightings, not a table you can
-- read. \`observer_faction_id\` is kept out of the view, so you see your own
-- reports and never learn what the enemy can see of you.
CREATE TABLE unit_sightings (
  id INTEGER PRIMARY KEY,
  observer_faction_id INTEGER NOT NULL,
  faction_id INTEGER NOT NULL,
  city_id INTEGER NOT NULL REFERENCES cities(id),
  turn INTEGER NOT NULL,
  unit_count INTEGER NOT NULL,
  strength INTEGER NOT NULL
);

CREATE VIEW scouting AS
  SELECT id, faction_id, city_id, turn, unit_count, strength
    FROM unit_sightings
   WHERE (SELECT faction_id FROM turn_state) = 0
      OR observer_faction_id = (SELECT faction_id FROM turn_state);


-- Roads run both ways. Every question about movement starts here.
CREATE VIEW road_links AS
  SELECT city_a AS city_id, city_b AS other_id FROM roads
  UNION ALL
  SELECT city_b AS city_id, city_a AS other_id FROM roads;

-- How many road hops lie between each pair of cities.
CREATE VIEW city_hops AS
  WITH RECURSIVE reach(origin, city_id, hops) AS (
    SELECT id, id, 0 FROM cities
    UNION
    SELECT reach.origin, road_links.other_id, reach.hops + 1
      FROM reach JOIN road_links ON road_links.city_id = reach.city_id
     WHERE reach.hops < (SELECT count(*) FROM cities)
  )
  SELECT origin, city_id, min(hops) AS hops FROM reach GROUP BY origin, city_id;

-- The one city each marching unit steps to next: the neighbour closest to
-- where it was sent. A tie goes to the lower city id, so the same seed and the
-- same orders always play out the same way.
CREATE VIEW unit_step AS
  SELECT u.id AS unit_id,
         (SELECT link.other_id
            FROM road_links link
            JOIN city_hops hop ON hop.origin = link.other_id AND hop.city_id = u.dest_city_id
           WHERE link.city_id = u.city_id
           ORDER BY hop.hops, link.other_id
           LIMIT 1) AS next_city_id
    FROM units u
   WHERE u.dest_city_id IS NOT NULL AND u.dest_city_id <> u.city_id;

-- Who is standing in each city and how hard they hit.
CREATE VIEW city_force AS
  SELECT city_id, faction_id, sum(strength) AS strength, count(*) AS unit_count
    FROM units GROUP BY city_id, faction_id;

-- Cities holding more than one faction. These fight.
CREATE VIEW contested_city AS
  SELECT city_id FROM city_force GROUP BY city_id HAVING count(DISTINCT faction_id) > 1;

-- The strongest faction in each contested city. A draw has no winner, so a
-- draw leaves nobody standing: every unit in that city is destroyed.
CREATE VIEW battle_winner AS
  SELECT f.city_id, f.faction_id
    FROM city_force f
   WHERE f.city_id IN (SELECT city_id FROM contested_city)
     AND f.strength = (SELECT max(strength) FROM city_force g WHERE g.city_id = f.city_id)
     AND (SELECT count(*) FROM city_force g WHERE g.city_id = f.city_id AND g.strength = f.strength) = 1;

-- A city one faction holds alone. Holding is what makes a city produce, and
-- what lets you build there.
CREATE VIEW held_city AS
  SELECT city_id, min(faction_id) AS faction_id, sum(strength) AS strength, count(*) AS unit_count
    FROM units GROUP BY city_id HAVING count(DISTINCT faction_id) = 1;


-- What this battle is fought over. One row, and the map you are on sets it
-- before your first turn:  SELECT * FROM objective;
--
--   cities  whoever holds the most cities when the turns run out.
--   region  whoever holds the most cities in the region named here. Hold every
--           city in it at the end of a turn and the battle ends there.
--   iron    whoever has the most iron in the cities they hold. Building spends
--           it, so an army is paid for out of the score.
--
-- A faction with no units and nothing queued is out whatever the objective,
-- and the last one standing wins. A tie on the objective goes to cities held,
-- and then to strength.
CREATE TABLE objective (
  kind TEXT NOT NULL CHECK (kind IN ('cities', 'region', 'iron')),
  region_id INTEGER REFERENCES regions(id)
);

-- The score the objective gives. It is built on held_city, which is built on
-- \`units\`, so it is fogged like everything else: you see your own line and
-- have to work out the rest from scouting.
CREATE VIEW objective_score AS
  SELECT h.faction_id,
         CASE (SELECT kind FROM objective)
           WHEN 'region' THEN sum(CASE WHEN c.region_id = (SELECT region_id FROM objective) THEN 1 ELSE 0 END)
           WHEN 'iron' THEN sum(coalesce(r.amount, 0))
           ELSE count(*)
         END AS score
    FROM held_city h
    JOIN cities c ON c.id = h.city_id
    LEFT JOIN resources r ON r.city_id = h.city_id AND r.kind = 'iron'
   GROUP BY h.faction_id;


-- === What an order may touch =================================================
--
-- Your orders may do two things: send your own units somewhere, and queue
-- units in a city you hold. Everything else raises an error, and an error
-- rolls the turn back and costs you nothing. Try things.

-- \`units\` is a view, so an order against it is caught by an INSTEAD OF
-- trigger: the trigger is the whole operation, and if it does not write
-- all_units then nothing is written. The tick needs no exemption here, because
-- the tick writes all_units directly and never passes through these.

CREATE TRIGGER units_are_not_made_by_hand INSTEAD OF INSERT ON units
BEGIN SELECT RAISE(ABORT, 'Units are not made by hand. Queue one in build_queue and wait for it.'); END;

CREATE TRIGGER units_are_not_removed_by_hand INSTEAD OF DELETE ON units
BEGIN SELECT RAISE(ABORT, 'Units are not removed by hand. Send something stronger.'); END;

-- Only the destination, and only on a unit the view let you see, which is only
-- ever one of yours.
CREATE TRIGGER units_take_only_a_destination INSTEAD OF UPDATE ON units
BEGIN
  SELECT RAISE(ABORT, 'dest_city_id is the only column of units an order may set.')
   WHERE NEW.id <> OLD.id OR NEW.faction_id <> OLD.faction_id OR NEW.type <> OLD.type
      OR NEW.city_id <> OLD.city_id OR NEW.strength <> OLD.strength;
  UPDATE all_units SET dest_city_id = NEW.dest_city_id WHERE id = OLD.id;
END;


-- Build orders. Iron is not taken when you queue an order: it is taken when
-- the unit appears. What the check below refuses is queueing more than the
-- city can pay for by the time everything in it is finished, so cancelling an
-- order with DELETE costs nothing and gives nothing back.

CREATE TRIGGER build_queue_is_for_your_faction BEFORE INSERT ON build_queue
WHEN (SELECT faction_id FROM turn_state) <> 0
 AND NEW.faction_id <> (SELECT faction_id FROM turn_state)
BEGIN SELECT RAISE(ABORT, 'You can only queue units for your own faction.'); END;

CREATE TRIGGER build_queue_wants_a_real_type BEFORE INSERT ON build_queue
WHEN NEW.unit_type NOT IN (SELECT type FROM unit_types)
BEGIN SELECT RAISE(ABORT, 'No such unit type. SELECT type FROM unit_types.'); END;

CREATE TRIGGER build_queue_wants_a_city_you_hold BEFORE INSERT ON build_queue
WHEN (SELECT faction_id FROM turn_state) <> 0
 AND NEW.city_id NOT IN (SELECT city_id FROM held_city WHERE faction_id = NEW.faction_id)
BEGIN SELECT RAISE(ABORT, 'You can only build in a city you hold on your own.'); END;

CREATE TRIGGER build_queue_takes_the_time_it_takes BEFORE INSERT ON build_queue
WHEN (SELECT faction_id FROM turn_state) <> 0
 AND NEW.turns_left <> (SELECT build_turns FROM unit_types WHERE type = NEW.unit_type)
BEGIN SELECT RAISE(ABORT, 'turns_left is not yours to pick. Take it from unit_types: INSERT INTO build_queue (faction_id, city_id, unit_type, turns_left) SELECT 1, 4, ''infantry'', build_turns FROM unit_types WHERE type = ''infantry'';'); END;

CREATE TRIGGER build_queue_needs_the_iron BEFORE INSERT ON build_queue
WHEN (SELECT faction_id FROM turn_state) <> 0
 AND coalesce((SELECT amount FROM resources WHERE city_id = NEW.city_id AND kind = 'iron'), 0)
   < (SELECT iron_cost FROM unit_types WHERE type = NEW.unit_type)
   + coalesce((SELECT sum(t.iron_cost) FROM build_queue b JOIN unit_types t ON t.type = b.unit_type
                WHERE b.city_id = NEW.city_id), 0)
BEGIN SELECT RAISE(ABORT, 'Not enough iron in that city for everything queued there.'); END;

CREATE TRIGGER build_queue_is_not_edited BEFORE UPDATE ON build_queue
WHEN (SELECT faction_id FROM turn_state) <> 0
BEGIN SELECT RAISE(ABORT, 'A queued order cannot be edited. DELETE it and queue another.'); END;

CREATE TRIGGER build_queue_cancels_only_yours BEFORE DELETE ON build_queue
WHEN (SELECT faction_id FROM turn_state) <> 0
 AND OLD.faction_id <> (SELECT faction_id FROM turn_state)
BEGIN SELECT RAISE(ABORT, 'That order is not yours to cancel.'); END;


