<file path="src/shared/progress/save-queue.ts">
import {
  isRetryable,
  type Checkpoint,
  type GameId,
  type LabsBridge,
  type Settings,
  type SubmitResult,
  type SubmitStats,
} from '../bridge/types';
import { readJson, writeJson, type KeyValueStore } from '../storage';

export type PendingSave =
  | { kind: 'checkpoint'; checkpoint: Checkpoint }
  | {
      kind: 'submit';
      game: GameId;
      missionId: string;
      answer: string | null;
      stats: SubmitStats;
    }
  | { kind: 'settings'; settings: Settings };

/** What the saving indicator shows. */
export type SaveStatus = 'idle' | 'saving' | 'saved' | 'retrying';

export const RETRY_DELAYS_MS = [2_000, 5_000, 15_000, 30_000, 60_000];

interface QueueOptions {
  storageKey: string;
  retryDelaysMs?: number[];
  onStatus?: (status: SaveStatus, pending: number) => void;
  onSubmitted?: (item: Extract<PendingSave, { kind: 'submit' }>, result: SubmitResult) => void;
}

/** Same checkpoint slot = same game and mission; same settings slot = always. */
function sameSlot(a: PendingSave, b: PendingSave): boolean {
  if (a.kind === 'checkpoint' && b.kind === 'checkpoint') {
    return (
      a.checkpoint.game === b.checkpoint.game && a.checkpoint.missionId === b.checkpoint.missionId
    );
  }
  return a.kind === 'settings' && b.kind === 'settings';
}

/**
 * Sends saves to the bridge one by one, in order. Failed saves stay in the
 * queue (kept in localStorage, so a refresh does not lose them) and are retried
 * with a growing delay. Only the latest checkpoint per mission is kept.
 */
export class SaveQueue {
  private items: PendingSave[];
  private running: Promise<void> | null = null;
  private retryTimer: ReturnType<typeof setTimeout> | null = null;
  private failures = 0;

  constructor(
    private readonly bridge: LabsBridge,
    private readonly store: KeyValueStore,
    private readonly options: QueueOptions,
  ) {
    this.items = readJson<PendingSave[]>(store, options.storageKey) ?? [];
  }

  get pending(): number {
    return this.items.length;
  }

  enqueue(item: PendingSave): Promise<void> {
    const index = this.items.findIndex((existing) => sameSlot(existing, item));
    if (index >= 0) this.items[index] = item;
    else this.items.push(item);
    this.persist();
    return this.flush();
  }

  /** Sends everything now. Resolves when the queue is empty or a save failed. */
  flush(): Promise<void> {
    if (this.retryTimer) {
      clearTimeout(this.retryTimer);
      this.retryTimer = null;
    }
    this.running ??= this.drain().finally(() => {
      this.running = null;
    });
    return this.running;
  }

  dispose(): void {
    if (this.retryTimer) clearTimeout(this.retryTimer);
    this.retryTimer = null;
  }

  private async drain(): Promise<void> {
    while (this.items.length) {
      const item = this.items[0];
      this.report('saving');
      try {
        await this.send(item);
      } catch (error) {
        if (isRetryable(error)) {
          this.scheduleRetry();
          return;
        }
        // The server refused this save (bad data, too large...): retrying cannot help.
        console.warn('[labs] save dropped', item.kind, error);
      }
      // A newer checkpoint may have replaced the item while it was being sent.
      if (this.items[0] === item) this.items.shift();
      this.failures = 0;
      this.persist();
    }
    this.report('saved');
  }

  private async send(item: PendingSave): Promise<void> {
    if (item.kind === 'checkpoint') {
      await this.bridge.saveCheckpoint(item.checkpoint);
    } else if (item.kind === 'settings') {
      await this.bridge.saveSettings(item.settings);
    } else {
      const result = await this.bridge.submitMission(
        item.game,
        item.missionId,
        item.answer,
        item.stats,
      );
      this.options.onSubmitted?.(item, result);
    }
  }

  private scheduleRetry(): void {
    const delays = this.options.retryDelaysMs ?? RETRY_DELAYS_MS;
    const delay = delays[Math.min(this.failures, delays.length - 1)];
    this.failures++;
    this.report('retrying');
    this.retryTimer = setTimeout(() => {
      this.retryTimer = null;
      void this.flush();
    }, delay);
  }

  private persist(): void {
    if (this.items.length) writeJson(this.store, this.options.storageKey, this.items);
    else this.store.remove(this.options.storageKey);
  }

  private report(status: SaveStatus): void {
    this.options.onStatus?.(status, this.items.length);
  }
}
</file>

<file path="src/shared/site/DevCredit.module.css">
/*
 * Credit ticket, ported from the Xplore platform's footer (club.ilisi.ma) so both
 * sites share it. Only the colour variables are mapped to the Labs theme.
 */

@property --dev-credit-angle {
  syntax: '<angle>';
  inherits: false;
  initial-value: 0deg;
}

.credit {
  --card: var(--color-card, #0e1834);
  --ring: var(--color-ring, #7aa2f7);
  --primary: var(--color-primary, #7aa2f7);
  --hairline: rgb(255 255 255 / 0.1);

  position: relative;
  display: inline-flex;
  padding: 2px;
  border-radius: 9999px;
  background:
    conic-gradient(
      from var(--dev-credit-angle),
      transparent 0 55%,
      #38bdf8 70%,
      #6366f1 80%,
      #ec4899 88%,
      transparent 100%
    ),
    var(--hairline);
  box-shadow: 0 10px 30px -16px rgb(99 102 241 / 0.6);
  transition:
    transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
    box-shadow 0.35s;
  animation: spin 4s linear infinite;
}

.credit:hover {
  transform: translateY(-3px);
  box-shadow: 0 14px 34px -14px rgb(99 102 241 / 0.55);
}

.credit:focus-visible {
  outline: 2px solid var(--ring);
  outline-offset: 3px;
}

.inner {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.375rem 1.125rem 0.375rem 0.375rem;
  border-radius: 9999px;
  background: var(--card);
}

.avatar {
  position: relative;
  display: grid;
  flex-shrink: 0;
  animation: float 3.6s ease-in-out infinite;
}

.avatar img {
  width: 3rem;
  height: 3rem;
  border-radius: 9999px;
  object-fit: cover;
  box-shadow:
    0 0 0 2px var(--card),
    0 0 0 3.5px #6366f1;
}

.avatar::after {
  content: '';
  position: absolute;
  inset: -4px;
  border: 2px solid rgb(56 189 248);
  border-radius: 9999px;
  opacity: 0;
  animation: ping 3.6s ease-out infinite;
}

/* Role badge on top of the avatar: a crown for the founder, code for developers. */
.badge {
  position: absolute;
  top: -0.7rem;
  left: 50%;
  z-index: 1;
  display: grid;
  place-items: center;
  width: 1.375rem;
  height: 1.375rem;
  border-radius: 9999px;
  color: #fff;
  background: linear-gradient(135deg, rgb(56 189 248), rgb(99 102 241) 55%, rgb(236 72 153));
  box-shadow:
    0 0 0 2px var(--card),
    0 4px 10px -3px #6366f1b3;
  translate: -50%;
}

.credit:hover .badge {
  animation: hop 0.6s ease-in-out;
}

/* The name rises letter by letter when the ticket scrolls into view, then waves on hover. */
.name > span {
  display: inline-block;
  white-space: pre;
  opacity: 0;
}

.credit[data-seen] .name > span {
  opacity: 1;
  animation: rise 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

.credit[data-seen]:hover .name > span {
  animation: wave 0.5s ease-in-out;
}

.github {
  transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.credit:hover .github {
  transform: rotate(360deg);
}

/* Founder: smaller, golden, slower. */
.credit[data-founder] {
  padding: 1.5px;
  background:
    conic-gradient(
      from var(--dev-credit-angle),
      transparent 0 60%,
      #fde68a 74%,
      #f59e0b 82%,
      transparent 92%
    ),
    var(--hairline);
  box-shadow: none;
  animation-duration: 7s;
}

.credit[data-founder]:hover {
  box-shadow: 0 12px 28px -14px rgb(245 158 11 / 0.5);
}

.credit[data-founder] .inner {
  gap: 0.5rem;
  padding: 0.25rem 0.75rem 0.25rem 0.25rem;
}

.credit[data-founder] .avatar img {
  width: 2rem;
  height: 2rem;
  box-shadow:
    0 0 0 2px var(--card),
    0 0 0 3px #f59e0b;
}

.credit[data-founder] .avatar::after {
  border-color: rgb(245 158 11);
}

.credit[data-founder] .badge {
  top: -0.55rem;
  width: 1rem;
  height: 1rem;
  background: linear-gradient(135deg, rgb(251 191 36), rgb(245 158 11) 55%, rgb(217 119 6));
  box-shadow: 0 0 0 2px var(--card);
}

.credit[data-founder]:hover .badge {
  animation: none;
}

@keyframes spin {
  100% {
    --dev-credit-angle: 360deg;
  }
}

@keyframes float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-2px);
  }
}

@keyframes ping {
  0% {
    opacity: 0.7;
    transform: scale(0.9);
  }
  60%,
  100% {
    opacity: 0;
    transform: scale(1.25);
  }
}

@keyframes rise {
  0% {
    opacity: 0;
    filter: blur(3px);
    transform: translateY(0.6em);
  }
  100% {
    opacity: 1;
    filter: none;
    transform: none;
  }
}

@keyframes wave {
  0%,
  100% {
    transform: none;
  }
  40% {
    color: var(--primary);
    transform: translateY(-3px);
  }
}

@keyframes hop {
  0%,
  100% {
    transform: translateY(0) rotate(0);
  }
  30% {
    transform: translateY(-3px) rotate(-8deg);
  }
  60% {
    transform: translateY(0) rotate(6deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  .credit,
  .avatar,
  .avatar::after,
  .credit[data-seen] .name > span,
  .credit[data-seen]:hover .name > span {
    animation: none;
  }

  .name > span {
    opacity: 1;
  }

  .credit:hover {
    transform: none;
  }
}
</file>

