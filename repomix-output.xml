-- @section opening

-- Most cities, unless the map says otherwise. The map is the one thing that
-- writes here after this, once, before anybody has a turn.
DELETE FROM objective;
INSERT INTO objective (kind, region_id) VALUES ('cities', NULL);

-- Iron is the only resource anything is spent on in this version, so every
-- city gets a stock of it and bigger cities get more. The other kinds sit in
-- the table as they were generated; nothing reads them yet.
DELETE FROM resources WHERE kind = 'iron';
INSERT INTO resources (city_id, kind, amount) SELECT id, 'iron', 30 + pop / 25000 FROM cities;

-- Each faction opens with two infantry and a scout in its home city, and
-- nothing anywhere else. Where the homes are is decided by the seed.
DELETE FROM build_queue;
DELETE FROM all_units;
INSERT INTO all_units (faction_id, type, city_id, dest_city_id, strength)
SELECT f.id, t.type, f.home_city_id, NULL, t.strength
  FROM factions f JOIN unit_types t ON t.type = 'infantry';
INSERT INTO all_units (faction_id, type, city_id, dest_city_id, strength)
SELECT f.id, t.type, f.home_city_id, NULL, t.strength
  FROM factions f JOIN unit_types t ON t.type = 'infantry';
INSERT INTO all_units (faction_id, type, city_id, dest_city_id, strength)
SELECT f.id, t.type, f.home_city_id, NULL, t.strength
  FROM factions f JOIN unit_types t ON t.type = 'scouts';


-- @section tick
--
-- What COMMIT sets off, in this order and only this order. Your orders and
-- the enemy's are already in the table by now; the tick does not know or care
-- who wrote them.

-- 1. Build queue advances. An order dies with the city that was building it:
--    lose the city, whether to the enemy or by marching the last unit out of
--    it, and the yard goes with it. Orders that come due take their iron and
--    stand up as units in the city that built them.
DELETE FROM build_queue
 WHERE city_id NOT IN (SELECT city_id FROM held_city WHERE faction_id = build_queue.faction_id);

UPDATE build_queue SET turns_left = turns_left - 1;

UPDATE resources
   SET amount = amount - coalesce((SELECT sum(t.iron_cost)
                                     FROM build_queue b JOIN unit_types t ON t.type = b.unit_type
                                    WHERE b.city_id = resources.city_id AND b.turns_left <= 0), 0)
 WHERE kind = 'iron'
   AND city_id IN (SELECT city_id FROM build_queue WHERE turns_left <= 0);

INSERT INTO all_units (faction_id, type, city_id, dest_city_id, strength)
SELECT b.faction_id, b.unit_type, b.city_id, NULL, t.strength
  FROM build_queue b JOIN unit_types t ON t.type = b.unit_type
 WHERE b.turns_left <= 0
 ORDER BY b.id;

DELETE FROM build_queue WHERE turns_left <= 0;

-- 2. Units move one road hop toward where they were sent, and forget the
--    order once they arrive.
UPDATE all_units
   SET city_id = (SELECT next_city_id FROM unit_step WHERE unit_step.unit_id = all_units.id)
 WHERE id IN (SELECT unit_id FROM unit_step WHERE next_city_id IS NOT NULL);

UPDATE all_units SET dest_city_id = NULL WHERE dest_city_id = city_id;

-- 3. Combat, one city at a time. The strongest faction in the city is the only
--    one left in it. Nobody is strongest in a draw, so a draw empties the city.
--
--    The losses are written down first and deleted second. Working it out
--    while the deleting is under way would mean reading city_force as it
--    changes, and the last unit of a winning side would look unopposed.
DELETE FROM battle_losses;

INSERT INTO battle_losses (unit_id, city_id, faction_id, strength)
SELECT u.id, u.city_id, u.faction_id, u.strength
  FROM units u
 WHERE u.city_id IN (SELECT city_id FROM contested_city)
   AND NOT EXISTS (SELECT 1 FROM battle_winner w
                    WHERE w.city_id = u.city_id AND w.faction_id = u.faction_id);

DELETE FROM all_units WHERE id IN (SELECT unit_id FROM battle_losses);

-- 4. Resources accrue, but only in cities one faction holds alone. A city with
--    nobody in it, or one still being fought over, produces nothing.
UPDATE resources
   SET amount = amount + max(1, (SELECT pop FROM cities WHERE cities.id = resources.city_id) / 25000)
 WHERE city_id IN (SELECT city_id FROM held_city);

-- 5. Scouting. Every faction writes down what its own units can see from
--    where they are standing. This is the only way anybody learns where
--    anybody else is, and it runs after the fighting, so an enemy you just
--    destroyed is not reported: there is nothing left to report.
--
--    Ordinary units see their own city and one road out. Scouts see two roads
--    out, which is the whole reason to build the things.
INSERT INTO unit_sightings (observer_faction_id, faction_id, city_id, turn, unit_count, strength)
SELECT watcher.faction_id,
       seen.faction_id,
       seen.city_id,
       (SELECT turn_number FROM turn_state),
       count(*),
       sum(seen.strength)
  FROM all_units seen
  JOIN (SELECT faction_id,
               city_id,
               max(CASE WHEN type = 'scouts' THEN 2 ELSE 1 END) AS sight
          FROM all_units GROUP BY faction_id, city_id) watcher
    ON watcher.faction_id <> seen.faction_id
   AND (SELECT hops FROM city_hops WHERE origin = watcher.city_id AND city_id = seen.city_id) <= watcher.sight
 GROUP BY watcher.faction_id, seen.faction_id, seen.city_id;

UPDATE turn_state SET turn_number = turn_number + 1;
