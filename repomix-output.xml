        cursor: pointer;
      }
      .controls button[aria-pressed='true'] {
        color: #fff;
        border-color: var(--accent);
      }

      /* A simplified game window around the dialogue, for context. */
      .game {
        width: min(100%, 1320px);
        height: 760px;
        display: grid;
        grid-template-rows: auto 1fr auto;
        background: var(--night);
        border: 1px solid color-mix(in srgb, var(--zone) 55%, var(--line));
        clip-path: polygon(
          14px 0,
          100% 0,
          100% calc(100% - 14px),
          calc(100% - 14px) 100%,
          0 100%,
          0 14px
        );
      }
      .topbar {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 18px;
        border-bottom: 1px solid var(--line);
        font-family: 'Pixelify Sans';
        font-size: 20px;
      }
      .topbar .n {
        color: var(--zone);
      }
      .work {
        display: grid;
        grid-template-columns: 55fr 45fr;
        min-height: 0;
      }
      .term {
        padding: 12px 14px;
        font-size: 14px;
        border-right: 1px solid var(--line);
      }
      .term .p {
        color: #9ece6a;
      }
      .term .p b {
        color: #7aa2f7;
        font-weight: 400;
      }
      .map {
        padding: 12px 16px;
        font-size: 13px;
        color: var(--muted);
        background: radial-gradient(circle at 1px 1px, rgb(169 177 214 / 0.07) 1px, transparent 0) 0
          0 / 14px 14px;
      }
      .phone .game {
        width: 375px;
        height: 812px;
        grid-template-rows: auto 1fr auto;
      }
      .phone .work {
        grid-template-columns: 1fr;
        grid-template-rows: 1fr 160px;
      }
      .phone .term {
        border-right: 0;
        border-bottom: 1px solid var(--line);
        font-size: 12px;
      }
      .phone .topbar {
        font-size: 15px;
      }

      /* ================= The proposed dialogue box ================= */
      .dialogue {
        --cut: 14px;
        position: relative;
        margin: 0 12px 12px;
        /* Border made of two clipped layers: accent outside, panel inside. */
        padding: 2px;
        background: linear-gradient(
          90deg,
          var(--accent),
          color-mix(in srgb, var(--accent) 35%, var(--line)) 45%,
          var(--line)
        );
        clip-path: polygon(
          var(--cut) 0,
          100% 0,
          100% calc(100% - var(--cut)),
          calc(100% - var(--cut)) 100%,
          0 100%,
          0 var(--cut)
        );
        transition: background 200ms;
      }
      .inner {
        position: relative;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        gap: 16px;
        align-items: stretch;
        min-height: 128px;
        padding: 12px 14px 12px 12px;
        background:
          linear-gradient(180deg, rgb(255 255 255 / 0.035), transparent 40%), var(--panel);
        clip-path: polygon(
          calc(var(--cut) - 1px) 0,
          100% 0,
          100% calc(100% - var(--cut) + 1px),
          calc(100% - var(--cut) + 1px) 100%,
          0 100%,
          0 calc(var(--cut) - 1px)
        );
      }

      /* Signal rail: a lit strip along the top in the accent colour, with a slow shimmer. */
      .rail {
        position: absolute;
        top: 0;
        left: 120px;
        right: 34%;
        height: 3px;
        overflow: hidden;
        background: linear-gradient(
          90deg,
          var(--accent) 0 60%,
          transparent 60% 63%,
          var(--accent) 63% 74%,
          transparent 74% 77%,
          var(--accent) 77% 82%,
          transparent 82%
        );
        opacity: 0.9;
        box-shadow: 0 0 10px color-mix(in srgb, var(--accent) 60%, transparent);
      }
      .rail::after {
        content: '';
        position: absolute;
        inset: 0;
        width: 30%;
        background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.85), transparent);
        animation: shimmer 2.8s ease-in-out infinite;
      }
      @keyframes shimmer {
        from {
          transform: translateX(-120%);
        }
        to {
          transform: translateX(380%);
        }
      }

      /* Hardware details: screws in the corners, status LEDs top right. */
      .screw {
        position: absolute;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: radial-gradient(circle at 35% 35%, #8b93b8, #3b4261 70%);
        box-shadow: 0 0 0 1px #0a1022;
      }
      .s1 {
        top: 7px;
        right: 8px;
      }
      .s2 {
        bottom: 7px;
        left: 8px;
      }
      .s3 {
        bottom: 7px;
        right: 26px;
      }
      .leds {
        position: absolute;
        top: 7px;
        right: 22px;
        display: flex;
        gap: 4px;
      }
      .leds i {
        width: 6px;
        height: 3px;
        background: #2a3354;
      }
      .leds i:first-child {
        background: var(--accent);
        box-shadow: 0 0 6px var(--accent);
      }
      .typing .leds i:first-child {
        animation: blink 0.6s steps(1) infinite;
      }
      @keyframes blink {
        50% {
          opacity: 0.25;
        }
      }

      /* Docking bay for Pixel's portrait. */
      .bay {
        position: relative;
        width: 96px;
        align-self: stretch;
        min-height: 104px;
        display: grid;
        place-items: end center;
        overflow: hidden;
        background:
          radial-gradient(
            70% 55% at 50% 100%,
            color-mix(in srgb, var(--accent) 35%, transparent),
            transparent 75%
          ),
          linear-gradient(180deg, #0d1638, var(--bay));
        clip-path: polygon(
          10px 0,
          100% 0,
          100% calc(100% - 10px),
          calc(100% - 10px) 100%,
          0 100%,
          0 10px
        );
        box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 45%, var(--line));
      }
      .bay::before,
      .bay::after {
        content: '';
        position: absolute;
        top: 14px;
        bottom: 14px;
        width: 2px;
        background: repeating-linear-gradient(
          180deg,
          color-mix(in srgb, var(--accent) 55%, transparent) 0 4px,
          transparent 4px 8px
        );
        opacity: 0.6;
      }
      .bay::before {
        left: 4px;
      }
      .bay::after {
        right: 4px;
      }
      .bay img {
        position: relative;
        z-index: 1;
        width: 84px;
        height: 84px;
        display: block;
        animation: pop 220ms cubic-bezier(0.34, 1.56, 0.64, 1);
      }
      /* A lit platform under Pixel. */
      .floor {
        position: absolute;
        left: 12px;
        right: 12px;
        bottom: 5px;
        height: 3px;
        border-radius: 2px;
        background: var(--accent);
        box-shadow: 0 0 12px 2px color-mix(in srgb, var(--accent) 70%, transparent);
        opacity: 0.85;
      }
      @keyframes pop {
        from {
          transform: scale(0.94);
          opacity: 0.6;
        }
      }
      .sparks {
        position: absolute;
        inset: 0;
        pointer-events: none;
        display: none;
      }
      .victory .sparks {
        display: block;
      }
      .sparks i {
        position: absolute;
        width: 8px;
        height: 8px;
        background: #ffe7a8;
        clip-path: polygon(50% 0, 62% 38%, 100% 50%, 62% 62%, 50% 100%, 38% 62%, 0 50%, 38% 38%);
        animation: twinkle 1.8s ease-in-out infinite;
        opacity: 0.55;
      }
      .sparks i:nth-child(1) {
        top: 10px;
        left: 12px;
      }
      .sparks i:nth-child(2) {
        top: 22px;
        right: 10px;
        animation-delay: 0.6s;
      }
      .sparks i:nth-child(3) {
        top: 46px;
        left: 8px;
        animation-delay: 1.1s;
        width: 6px;
        height: 6px;
      }
      @keyframes twinkle {
        50% {
          transform: scale(0.4) rotate(45deg);
          opacity: 0.15;
        }
      }

      /* Name tag + text. */
      .copy {
        position: relative;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding-top: 2px;
      }
      /* Connector from the bay: Pixel is the one speaking. */
      .copy::before {
        content: '';
        position: absolute;
        left: -13px;
        top: 8px;
        width: 8px;
        height: 12px;
        background: var(--accent);
        clip-path: polygon(0 0, 100% 50%, 0 100%);
        opacity: 0.85;
      }
      .tag {
        align-self: flex-start;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 2px 10px 2px 8px;
        font: 700 13px/1.4 'Pixelify Sans';
        letter-spacing: 0.08em;
        color: var(--accent);
        background: color-mix(in srgb, var(--accent) 13%, transparent);
        clip-path: polygon(
          0 0,
          calc(100% - 7px) 0,
          100% 7px,
          100% 100%,
          7px 100%,
          0 calc(100% - 7px)
        );
      }
      .tag .role {
        color: var(--faint);
        font-weight: 500;
        letter-spacing: 0.04em;
      }
      .tag svg {
        width: 13px;
        height: 13px;
      }
      .text {
        font-size: 16px;
        line-height: 1.45;
        color: var(--text);
        max-width: 76ch;
      }
      .caret {
        display: inline-block;
        width: 9px;
        height: 1.05em;
        margin-left: 2px;
        vertical-align: -2px;
        background: var(--accent);
        animation: blink 0.85s steps(1) infinite;
      }
      .done .caret {
        display: none;
      }

      /* Actions. */
      .actions {
        display: flex;
        align-items: flex-end;
        gap: 8px;
        padding-right: 6px;
      }
      .btn {
        min-width: 110px;
        height: 40px;
        padding: 0 16px;
        border: 0;
        cursor: pointer;
        font: 700 14px/1 'Pixelify Sans';
        letter-spacing: 0.06em;
        color: #0b1230;
        background: var(--accent);
        clip-path: polygon(
          0 0,
          calc(100% - 9px) 0,
          100% 9px,
          100% 100%,
          9px 100%,
          0 calc(100% - 9px)
        );
        box-shadow:
          inset 0 2px 0 rgb(255 255 255 / 0.35),
          inset 0 -3px 0 rgb(0 0 0 / 0.22);
        transition:
          filter 160ms,
          transform 120ms;
      }
      .btn:hover {
        filter: brightness(1.12);
      }
      .btn:active {
        transform: translateY(1px);
        filter: brightness(0.9);
      }
      .btn .step {
        font-family: 'JetBrains Mono';
        font-weight: 600;
        font-size: 12px;
        opacity: 0.75;
        margin-left: 6px;
      }
      .typing .btn {
        color: var(--accent);
        background: transparent;
        box-shadow: inset 0 0 0 2px var(--accent);
      }
      .icon {
        width: 36px;
        height: 36px;
        display: grid;
        place-items: center;
        cursor: pointer;
        color: var(--muted);
        background: #121c3d;
        border: 1px solid var(--line);
      }
      .icon:hover {
        color: var(--text);
        border-color: var(--accent);
      }

      /* Minimized: Pixel's round face with a halo; the row shrinks, the terminal never moves under it. */
      .mini {
        display: none;
        align-items: center;
        gap: 12px;
        margin: 0 12px 12px;
        padding: 6px 14px 6px 6px;
        width: max-content;
        cursor: pointer;
        border: 0;
        color: var(--text);
        background: var(--panel);
        clip-path: polygon(
          10px 0,
          100% 0,
          100% calc(100% - 10px),
          calc(100% - 10px) 100%,
          0 100%,
          0 10px
        );
        box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 55%, var(--line));
        font: 13px 'JetBrains Mono';
      }
      .mini .face {
        position: relative;
        width: 52px;
        height: 52px;
        border-radius: 50%;
        overflow: hidden;
        background: var(--bay);
        box-shadow:
          0 0 0 2px var(--accent),
          0 0 14px color-mix(in srgb, var(--accent) 55%, transparent);
      }
      .mini .face img {
        width: 52px;
        height: 52px;
        display: block;
      }
      .mini .dot {
        position: absolute;
        top: 3px;
        right: 3px;
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: var(--accent);
        box-shadow: 0 0 0 2px var(--panel);
      }
      .mini b {
        font: 700 13px 'Pixelify Sans';
        color: var(--accent);
        letter-spacing: 0.08em;
      }
      .minimized .dialogue {
        display: none;
      }
      .minimized .mini {
        display: inline-flex;
      }

      /* Phone. */
      .phone .dialogue {
        margin: 0 8px 8px;
      }
      .phone .inner {
        grid-template-columns: auto minmax(0, 1fr);
        gap: 10px 12px;
        min-height: 150px;
        padding: 10px;
      }
      .phone .bay {
        width: 68px;
        min-height: 76px;
        align-self: start;
      }
      .phone .bay img {
        width: 62px;
        height: 62px;
      }
      .phone .copy::before {
        left: -9px;
      }
      .phone .text {
        font-size: 14px;
      }
      .phone .actions {
        grid-column: 1 / -1;
        justify-content: flex-end;
        padding-right: 0;
      }
      .phone .rail {
        left: 84px;
        right: 20%;
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation: none !important;
          transition: none !important;
        }
      }
    </style>
  </head>
  <body>
    <div class="controls" id="controls"></div>

    <div class="game" id="game">
      <div class="topbar">
        <span>←</span><span class="n" id="order">4.</span><span>Jour de déménagement</span>
      </div>
      <div class="work">
        <div class="term">
          <div>Serveur FST, Linux 6.1. Tape help pour voir les commandes disponibles.</div>
          <br />
          <div class="p">intern@fst:<b>~</b>$ <span style="color: var(--text)">cd desk</span></div>
          <div class="p">
            intern@fst:<b>~/desk</b>$ <span style="color: var(--text)">cat TODO.txt</span>
          </div>
          <div>
            TODO before the President sees this desk:<br />1. Make two folders here: courses and
            exams<br />2. Move both course PDFs into courses<br />5. COPY (do not move!)
            msemen-recipe.txt into president/
          </div>
          <div class="p">intern@fst:<b>~/desk</b>$ <span style="color: var(--text)">▌</span></div>
        </div>
        <div class="map">
          ~/desk<br /><br />□ /<br />&nbsp;└□ home<br />&nbsp;&nbsp;&nbsp;└□ intern<br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;└□
          <span style="color: var(--zone)">desk</span
          ><br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;○ TODO.txt
        </div>
      </div>

      <section class="dialogue" id="dialogue" aria-label="Pixel">
        <div class="inner">
          <div class="rail" aria-hidden="true"></div>
          <i class="screw s1"></i><i class="screw s2"></i><i class="screw s3"></i>
          <div class="leds" aria-hidden="true"><i></i><i></i><i></i></div>
          <div class="bay">
            <span class="floor" aria-hidden="true"></span><img id="face" alt="" />
            <div class="sparks"><i></i><i></i><i></i></div>
          </div>
          <div class="copy">
            <span class="tag"><span id="icon"></span>PIXEL<span class="role">// GUIDE</span></span>
            <p class="text" aria-live="polite">
              <span id="text"></span><span class="caret"></span>
            </p>
          </div>
          <div class="actions">
            <button class="btn" id="next"></button>
            <button class="icon" id="minimize" aria-label="Réduire le dialogue" title="Réduire">
              <svg width="14" height="14" viewBox="0 0 14 14">
                <path d="M2 10h10" stroke="currentColor" stroke-width="2" />
              </svg>
            </button>
          </div>
        </div>
      </section>
      <button class="mini" id="mini" aria-label="Rouvrir le dialogue">
        <span class="face"><img id="miniFace" alt="" /><span class="dot"></span></span
        ><span><b>PIXEL</b><br />Rouvrir</span>
      </button>
    </div>

    <script>
      const FACES = '../../public/games/linux/characters/pixel/face-';
      const ZONES = [
        ['Réveil', '#7aa2f7'],
        ['Archives', '#9ece6a'],
        ['Recherche', '#e0af68'],
        ['Pipes', '#bb9af7'],
        ['Coffre', '#f7768e'],
        ['Enquêtes', '#7dcfff'],
      ];
      const KINDS = {
        briefing: {
          mood: 'neutral',
          accent: null,
          step: '2/4',
          text: 'Le Président passe inspecter dans dix minutes. S’il voit ce bordel, safi, on est finis.',
        },
        hint: {
          mood: 'thinking',
          accent: '#4cc9ff',
          step: '1/1',
          text: 'Certains fichiers commencent par un point… et ls fait comme s’ils n’existaient pas.',
        },
        mistake: {
          mood: 'shocked',
          accent: '#f7768e',
          step: '1/1',
          text: 'Tu as DÉPLACÉ la recette ? TODO.txt disait COPIER. Le bureau n’a plus de msemen.',
        },
        victory: {
          mood: 'proud',
          accent: '#e0af68',
          step: '1/2',
          text: 'Bureau rangé, recette sauvée. Le Président est passé et il a souri. Il ne sourit jamais.',
        },
      };
      const ICONS = {
        hint: '<svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 1a5 5 0 0 0-3 9v2h6v-2a5 5 0 0 0-3-9zM6 14h4v1H6z"/></svg>',
        mistake:
          '<svg viewBox="0 0 16 16" fill="currentColor"><path d="M7 2h2v8H7zM7 12h2v2H7z"/></svg>',
        victory:
          '<svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 1l2 5h5l-4 3 2 5-5-3-5 3 2-5-4-3h5z"/></svg>',
      };
      const q = new URLSearchParams(location.search);
      const state = {
        kind: q.get('kind') || 'briefing',
        zone: +(q.get('zone') ?? 1),
        done: q.get('done') === '1',
        min: q.get('min') === '1',
        phone: q.get('phone') === '1',
      };
      const $ = (id) => document.getElementById(id);
      let timer;

      function render() {
        const k = KINDS[state.kind];
        const zone = ZONES[state.zone % ZONES.length][1];
        document.documentElement.style.setProperty('--zone', zone);
        document.documentElement.style.setProperty('--accent', k.accent || zone);
        document.body.classList.toggle('phone', state.phone);
        $('game').classList.toggle('minimized', state.min);
        const d = $('dialogue');
        d.classList.toggle('victory', state.kind === 'victory');
        $('face').src = $('miniFace').src = FACES + k.mood + '.webp';
        $('icon').innerHTML = ICONS[state.kind] || '';
        clearInterval(timer);
        const show = (n) => {
          $('text').textContent = k.text.slice(0, n);
        };
        const finish = () => {
          clearInterval(timer);
          show(k.text.length);
          d.classList.add('done');
          d.classList.remove('typing');
          $('next').innerHTML = 'SUIVANT<span class="step">' + k.step + '</span>';
        };
        if (state.done) return finish();
        d.classList.remove('done');
        d.classList.add('typing');
        $('next').innerHTML = 'PASSER »';
        let n = Math.round(k.text.length * 0.45);
        show(n);
        timer = setInterval(() => (++n >= k.text.length ? finish() : show(n)), 22);
      }

      function controls() {
        const c = $('controls');
        c.innerHTML = '';
        const add = (label, on, fn) => {
          const b = document.createElement('button');
          b.textContent = label;
          b.setAttribute('aria-pressed', on);
          b.onclick = () => {
            fn();
            controls();
            render();
          };
          c.append(b);
        };
        for (const kind of Object.keys(KINDS))
          add(kind, state.kind === kind, () => {
            state.kind = kind;
            state.done = false;
          });
        add('zone: ' + ZONES[state.zone][0], false, () => {
          state.zone = (state.zone + 1) % ZONES.length;
        });
        add(state.done ? 'complete' : 'typing', state.done, () => {
          state.done = !state.done;
        });
        add('minimized', state.min, () => {
          state.min = !state.min;
        });
        add('phone', state.phone, () => {
          state.phone = !state.phone;
        });
      }
      $('next').onclick = () => {
        if (!state.done) {
          state.done = true;
          render();
          controls();
        }
      };
      $('minimize').onclick = () => {
        state.min = true;
        render();
        controls();
      };
      $('mini').onclick = () => {
        state.min = false;
        render();
        controls();
      };
      controls();
      render();
    </script>
  </body>
</html>
</file>

