/*
 * Xplore Labs design tokens. Terminal colors from Tokyo Night (PRD section 8).
 * Each zone sets --zone on the game screen.
 */
:root {
  --night: #1a1b26;
  --deep: #16161e;
  --storm: #24283b;
  --line: #3b4261;
  --text: #c0caf5;
  /* Readable secondary text (Tokyo Night's #565f89 is too faint for UI text). */
  --muted: #9aa5ce;
  --faint: #737aa2;
  --ok: #9ece6a;
  --warn: #e0af68;
  --danger: #f7768e;
  --zone: #7aa2f7;

  --radius: 6px;
  --space-1: 0.25rem;
  --space-2: 0.5rem;
  --space-3: 0.75rem;
  --space-4: 1rem;
  --space-6: 1.5rem;

  --text-sm: 0.8125rem;
  --text-base: 0.9375rem;
  --text-lg: 1.125rem;
  --text-xl: 1.5rem;

  color-scheme: dark;
}

/*
 * Element defaults sit in the base layer, under the Tailwind utilities of the
 * website (app/site.css). CSS modules are not layered, so they still win.
 */
@layer base {
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
  }

  body {
    background:
      radial-gradient(ellipse 80% 60% at 70% 0%, rgb(122 162 247 / 0.08), transparent 70%),
      radial-gradient(ellipse 60% 50% at 0% 100%, rgb(187 154 247 / 0.07), transparent 70%),
      var(--night);
    color: var(--text);
    font-family: var(--font-mono), ui-monospace, Consolas, monospace;
    font-size: var(--text-base);
    line-height: 1.5;
  }

  a {
    color: inherit;
  }

  button,
  input {
    font: inherit;
    color: inherit;
  }

  :focus-visible {
    outline: 2px solid var(--zone);
    outline-offset: 2px;
  }
}

/* The player's "reduced motion" setting (the OS setting is handled per component). */
[data-reduced-motion] *,
[data-reduced-motion] *::before,
[data-reduced-motion] *::after {
  animation: none !important;
  transition: none !important;
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
