<file path="scripts/cut-mascot.mjs">
/**
 * Cuts Pixel's expression sheet into one small image per mood.
 *
 *   node scripts/cut-mascot.mjs
 *
 * Source: public/games/linux/characters/pixel/source/ (AI art, see PRD section 6).
 * Output: public/games/linux/characters/pixel/face-<mood>.webp and body-<pose>.webp.
 * Run it again after replacing the source art; the game only uses the output files.
 */
import { mkdirSync } from 'node:fs';
import { join } from 'node:path';
import sharp from 'sharp';

const DIR = 'public/games/linux/characters/pixel';
const SHEET = join(DIR, 'source/Penguin Expression.png');
const PROUD = join(DIR, 'source/penguin-proud.png');

/** Faces are drawn up to 96 CSS px: 256 px covers high-density screens. */
const FACE = 256;
/** Every head is scaled to this width, so all moods have the same size. */
const HEAD_WIDTH = 216;
const BODY_HEIGHT = 384;

/** Figures on the sheet, in reading order (found by `findFigures`). */
const SHEET_FIGURES = [
  'body-idle',
  'face-neutral',
  'face-happy',
  'face-thinking',
  'face-shocked',
  null, // "determined": not one of the game's moods (kept in the source sheet)
  'face-disappointed',
  'face-laughing',
  'face-sleeping',
  'body-typing',
];

/** Bounding boxes of the opaque figures: alpha mask at 1/4 scale, then flood fill. */
async function findFigures(file) {
  const { data, info } = await sharp(file)
    .ensureAlpha()
    .raw()
    .toBuffer({ resolveWithObject: true });
  const K = 4;
  const W = Math.ceil(info.width / K);
  const H = Math.ceil(info.height / K);
  const mask = new Uint8Array(W * H);
  for (let y = 0; y < info.height; y++)
    for (let x = 0; x < info.width; x++)
      if (data[(y * info.width + x) * 4 + 3] > 128) mask[((y / K) | 0) * W + ((x / K) | 0)] = 1;

  const seen = new Uint8Array(W * H);
  const boxes = [];
  for (let start = 0; start < W * H; start++) {
    if (!mask[start] || seen[start]) continue;
    const stack = [start];
    seen[start] = 1;
    let minX = W,
      minY = H,
      maxX = 0,
      maxY = 0,
      area = 0;
    while (stack.length) {
      const p = stack.pop();
      const x = p % W;
      const y = (p / W) | 0;
      area++;
      minX = Math.min(minX, x);
      maxX = Math.max(maxX, x);
      minY = Math.min(minY, y);
      maxY = Math.max(maxY, y);
      for (const q of [p - 1, p + 1, p - W, p + W]) {
        if (q < 0 || q >= W * H || seen[q] || !mask[q] || Math.abs((q % W) - x) > 1) continue;
        seen[q] = 1;
        stack.push(q);
      }
    }
    // Small pieces (the "zzz" of the sleeping face) are not figures.
    if (area > 200)
      boxes.push({
        left: minX * K,
        top: minY * K,
        width: (maxX - minX + 1) * K,
        height: (maxY - minY + 1) * K,
      });
  }
  // Reading order: rows of about 300 px, then left to right.
  return boxes.sort((a, b) => Math.round(a.top / 300) - Math.round(b.top / 300) || a.left - b.left);
}

/** Makes nearly opaque pixels fully opaque (the generator exports them at ~96%). */
async function solidify(image) {
  const { data, info } = await image.ensureAlpha().raw().toBuffer({ resolveWithObject: true });
  for (let i = 3; i < data.length; i += 4) if (data[i] >= 200) data[i] = 255;
  return sharp(data, { raw: info });
}

/**
 * A head on a square canvas: same width for every mood, centred, sitting on the
 * bottom edge (the hoodie is cut there). `extra` widens the cut area upward and
 * to the right, for the sleeping "zzz".
 */
async function face(file, box, out, extra = { top: 0, right: 0 }) {
  const meta = await sharp(file).metadata();
  const area = {
    left: box.left,
    top: Math.max(0, box.top - extra.top),
    width: Math.min(meta.width - box.left, box.width + extra.right),
    height: box.height + Math.min(box.top, extra.top),
  };
  const scale = HEAD_WIDTH / box.width;
  const cut = await (
    await solidify(sharp(file).extract(area))
  )
    .resize(Math.round(area.width * scale), Math.round(area.height * scale))
    .png()
    .toBuffer();
  const cutMeta = await sharp(cut).metadata();
  // Keep the head centred even when the cut area is wider (zzz on the right).
  const left = Math.round((FACE - HEAD_WIDTH) / 2);
  const top = Math.max(0, FACE - cutMeta.height);
  const fitted = await sharp(cut)
    .extract({
      left: 0,
      top: Math.max(0, cutMeta.height - FACE),
      width: Math.min(cutMeta.width, FACE - left),
      height: Math.min(cutMeta.height, FACE),
    })
    .toBuffer();
  await sharp({
    create: { width: FACE, height: FACE, channels: 4, background: { r: 0, g: 0, b: 0, alpha: 0 } },
  })
    .composite([{ input: fitted, left, top }])
    .webp({ quality: 88, alphaQuality: 100 })
    .toFile(join(DIR, `${out}.webp`));
}

async function body(file, box, out) {
  await (
    await solidify(sharp(file).extract(box))
  )
    .resize({ height: BODY_HEIGHT })
    .webp({ quality: 88, alphaQuality: 100 })
    .toFile(join(DIR, `${out}.webp`));
}

mkdirSync(DIR, { recursive: true });
const figures = await findFigures(SHEET);
if (figures.length !== SHEET_FIGURES.length)
  throw new Error(`Expected ${SHEET_FIGURES.length} figures on the sheet, found ${figures.length}`);

for (const [index, name] of SHEET_FIGURES.entries()) {
  if (!name) continue;
  const box = figures[index];
  if (name.startsWith('body-')) await body(SHEET, box, name);
  else if (name === 'face-sleeping') await face(SHEET, box, name, { top: 44, right: 14 });
  else await face(SHEET, box, name);
}

const [proud] = await findFigures(PROUD);
await face(PROUD, proud, 'face-proud');
console.log('Pixel: faces and bodies written to', DIR);
</file>

<file path="scripts/make-sounds.mjs">
/**
 * Generates the placeholder sound effects (original, synthesized: no license
 * issues). Replace any file in public/games/linux/sounds/ with a real recording
 * of the same name.
 *
 *   node scripts/make-sounds.mjs
 */
import { mkdirSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';

const RATE = 22050;
const out = join(process.cwd(), 'public/games/linux/sounds');

/** Deterministic noise, so the files do not change on every run. */
let seed = 42;
const noise = () => {
  seed = (seed * 1103515245 + 12345) & 0x7fffffff;
  return (seed / 0x7fffffff) * 2 - 1;
};

const sine = (f, t) => Math.sin(2 * Math.PI * f * t);
const square = (f, t) => (sine(f, t) >= 0 ? 1 : -1);
const saw = (f, t) => 2 * ((f * t) % 1) - 1;
const triangle = (f, t) => 2 * Math.abs(saw(f, t)) - 1;
const env = (t, attack, length) =>
  t < attack ? t / attack : Math.max(0, Math.exp((-(t - attack) * 5) / length));

function render(seconds, fn) {
  const samples = new Float32Array(Math.round(seconds * RATE));
  for (let i = 0; i < samples.length; i++) samples[i] = fn(i / RATE, i);
  return samples;
}

/** Notes one after the other: [frequency, duration] with a shared voice. */
function sequence(notes, voice, gap = 0) {
  const total = notes.reduce((sum, [, d]) => sum + d + gap, 0);
  return render(total, (t) => {
    let start = 0;
    for (const [f, d] of notes) {
      if (t < start + d) return f ? voice(f, t - start, d) : 0;
      start += d + gap;
    }
    return 0;
  });
}

function lowpass(samples, amount) {
  let last = 0;
  return samples.map((x) => (last += amount * (x - last)));
}

function wav(name, samples, volume = 0.6) {
  const peak = Math.max(...samples.map(Math.abs)) || 1;
  const data = Buffer.alloc(samples.length * 2);
  samples.forEach((s, i) => data.writeInt16LE(Math.round((s / peak) * volume * 32767), i * 2));
  const header = Buffer.alloc(44);
  header.write('RIFF', 0);
  header.writeUInt32LE(36 + data.length, 4);
  header.write('WAVEfmt ', 8);
  header.writeUInt32LE(16, 16);
  header.writeUInt16LE(1, 20);
  header.writeUInt16LE(1, 22);
  header.writeUInt32LE(RATE, 24);
  header.writeUInt32LE(RATE * 2, 28);
  header.writeUInt16LE(2, 32);
  header.writeUInt16LE(16, 34);
  header.write('data', 36);
  header.writeUInt32LE(data.length, 40);
  writeFileSync(join(out, `${name}.wav`), Buffer.concat([header, data]));
  console.log(`${name}.wav  ${((44 + data.length) / 1024).toFixed(0)} KB`);
}

mkdirSync(out, { recursive: true });

// Success ding: two bell partials.
wav(
  'ding',
  render(0.7, (t) => (sine(1318, t) + 0.5 * sine(1976, t)) * env(t, 0.005, 0.25)),
);

// Error bonk: falling low tone.
wav(
  'bonk',
  render(0.2, (t) => sine(220 - 600 * t, t) * env(t, 0.003, 0.08)),
  0.5,
);

// Combo for pipe chains: quick rising notes.
wav(
  'combo',
  sequence(
    [
      [660, 0.07],
      [880, 0.07],
      [1320, 0.12],
    ],
    (f, t, d) => triangle(f, t) * env(t, 0.004, d),
  ),
  0.45,
);

// Zone / mission victory: arpeggio.
wav(
  'victory',
  sequence(
    [
      [523, 0.11],
      [659, 0.11],
      [784, 0.11],
      [1046, 0.5],
    ],
    (f, t, d) => (triangle(f, t) + 0.3 * sine(f * 2, t)) * env(t, 0.005, d * 0.6),
  ),
);

// Penguin talk blip: short, high and cute.
wav(
  'blip',
  render(0.035, (t) => square(1250, t) * env(t, 0.002, 0.015)),
  0.18,
);

// Dramatic: low falling rumble.
wav(
  'dramatic',
  lowpass(
    render(
      1.3,
      (t) => (saw(110 - 50 * t, t) + 0.6 * noise()) * (0.6 + 0.4 * sine(6, t)) * env(t, 0.02, 0.5),
    ),
    0.15,
  ),
);

// Sad violin: slow descending notes with vibrato.
wav(
  'sad-violin',
  lowpass(
    sequence(
      [
        [392, 0.45],
        [370, 0.45],
        [349, 0.45],
        [330, 0.9],
      ],
      (f, t, d) =>
        saw(f * (1 + 0.012 * sine(5.5, t)), t) * Math.min(1, t * 8) * Math.min(1, (d - t) * 6),
    ),
    0.08,
  ),
  0.5,
);

// Applause: noise with random claps.
const claps = Array.from({ length: 28 }, () => Math.abs(noise()) * 1.4);
wav(
  'applause',
  lowpass(
    render(1.6, (t) => {
      let amp = 0;
      for (const at of claps) if (t >= at && t < at + 0.03) amp += 1 - (t - at) / 0.03;
      return noise() * (0.25 + amp) * Math.min(1, (1.6 - t) * 2);
    }),
    0.5,
  ),
  0.5,
);

// Giggle: bouncing chirps.
wav(
  'giggle',
  sequence(
    [
      [700, 0.08],
      [0, 0.03],
      [820, 0.08],
      [0, 0.03],
      [760, 0.08],
      [0, 0.03],
      [900, 0.12],
    ],
    (f, t, d) => sine(f * (1 + 0.15 * sine(30, t)), t) * env(t, 0.004, d),
  ),
  0.5,
);

// Snore: slow breathing noise.
wav(
  'snore',
  lowpass(
    render(
      1.8,
      (t) =>
        noise() * Math.max(0, Math.sin(Math.PI * (t / 0.9))) ** 2 * (0.6 + 0.4 * square(38, t)),
    ),
    0.06,
  ),
  0.5,
);

// Train: chuffs, then a two-tone whistle.
wav(
  'train',
  render(1.4, (t) => {
    const chuff = t < 0.8 ? noise() * Math.max(0, Math.sin(Math.PI * ((t * 5) % 1))) ** 4 : 0;
    const whistle = t >= 0.8 ? (sine(740, t) + sine(880, t)) * 0.4 * Math.min(1, (1.4 - t) * 5) : 0;
    return chuff + whistle;
  }),
  0.5,
);

// Door slam (permission denied): thump and rattle.
wav(
  'door',
  render(0.35, (t) => sine(80, t) * env(t, 0.002, 0.08) + noise() * 0.4 * env(t, 0.002, 0.04)),
  0.6,
);
</file>

<file path="scripts/process-map.mjs">
/**
 * Turns the AI island art into the images of the mission map.
 *
 *   node scripts/process-map.mjs
 *
 * Source: design/linux/map/island-<name>.png (1254 px, about 2 MB each; not deployed).
 * Output: public/games/linux/map/<zone-id>.webp: fully opaque, trimmed, the same
 * margin around every island, 720 px (shown up to about 360 px wide).
 */
import { join } from 'node:path';
import sharp from 'sharp';

const DIR = 'public/games/linux/map';
const SOURCE = 'design/linux/map';
const SIZE = 720;
/** Empty space around the island, as a share of the image. */
const MARGIN = 0.04;

/** Source file -> zone id (src/games/linux/meta.ts). */
const ISLANDS = {
  'island-wake-up.png': 'wake-up-room',
  'island-archive.png': 'archive',
  'island-search-hall.png': 'search-hall',
  'island-pipe-factory.png': 'pipe-factory',
  'island-guarded-vault.png': 'guarded-vault',
  'island-detective.png': 'detective',
};

for (const [file, zone] of Object.entries(ISLANDS)) {
  const { data, info } = await sharp(join(SOURCE, file))
    .ensureAlpha()
    .raw()
    .toBuffer({ resolveWithObject: true });
  // The generator exports the island at ~96% opacity, and a few stray pixels at 1-16.
  for (let i = 3; i < data.length; i += 4) {
    if (data[i] >= 200) data[i] = 255;
    else if (data[i] <= 16) data[i] = 0;
  }
  const trimmed = await sharp(data, { raw: info }).trim({ threshold: 0 }).png().toBuffer();
  const { width, height } = await sharp(trimmed).metadata();
  const side = Math.round(Math.max(width, height) / (1 - 2 * MARGIN));
  // Two steps: sharp resizes before it composites inside one pipeline.
  const square = await sharp({
    create: { width: side, height: side, channels: 4, background: { r: 0, g: 0, b: 0, alpha: 0 } },
  })
    .composite([{ input: trimmed, gravity: 'centre' }])
    .png()
    .toBuffer();
  await sharp(square)
    .resize(SIZE, SIZE)
    .webp({ quality: 86, alphaQuality: 100 })
    .toFile(join(DIR, `${zone}.webp`));
  console.log(`${zone}.webp`);
}
</file>

