<file path="src/games/linux/engine/commands/find.ts">
import { errorText, type ErrorKind } from '../types';
import type { VfsNode } from '../vfs/vfs';
import type { Command } from './types';
import { failure, globToRegExp, lastSegment, statusOf } from './util';

type Test = (name: string, node: VfsNode) => boolean;

export const find: Command = {
  name: 'find',
  help: {
    usage: 'find [folder]... [-name pattern] [-iname pattern] [-type f|d]',
    summary: {
      en: 'Search for files in a folder and all its sub-folders. Put patterns in quotes: -name "*.txt".',
      fr: 'Cherche des fichiers dans un dossier et tous ses sous-dossiers. Mets les motifs entre guillemets : -name "*.txt".',
    },
  },
  run(ctx) {
    const { args } = ctx;
    const starts: string[] = [];
    let i = 0;
    while (i < args.length && !args[i].startsWith('-')) starts.push(args[i++]);

    const tests: Test[] = [];
    while (i < args.length) {
      const flag = args[i++];
      if (!['-name', '-iname', '-type'].includes(flag)) {
        ctx.err(`find: unknown predicate '${flag}'\n`);
        return failure('usage');
      }
      const value = args[i++];
      if (value === undefined) {
        ctx.err(`find: missing argument to '${flag}'\n`);
        return failure('usage');
      }
      if (flag === '-type') {
        if (value !== 'f' && value !== 'd') {
          ctx.err(`find: Unknown argument to -type: ${value}\n`);
          return failure('usage');
        }
        tests.push((_, node) => (node.type === 'dir') === (value === 'd'));
      } else {
        const regex = globToRegExp(value, flag === '-iname');
        tests.push((name) => regex.test(name));
      }
    }

    const { vfs, user } = ctx.shell;
    let failed: ErrorKind | undefined;
    const visit = (node: VfsNode, label: string, name: string) => {
      if (tests.every((test) => test(name, node))) ctx.out(`${label}\n`);
      if (node.type !== 'dir') return;
      if (!vfs.can(node, user, 'r') || !vfs.can(node, user, 'x')) {
        ctx.err(`find: '${label}': Permission denied\n`);
        failed ??= 'permission_denied';
        return;
      }
      const children = [...node.children.values()].sort((a, b) => (a.name < b.name ? -1 : 1));
      for (const child of children) {
        visit(child, label === '/' ? `/${child.name}` : `${label}/${child.name}`, child.name);
      }
    };

    for (const start of starts.length ? starts : ['.']) {
      const found = vfs.lookup(ctx.resolve(start), user);
      if (!found.ok) {
        ctx.err(`find: '${start}': ${errorText(found.error)}\n`);
        failed ??= found.error;
        continue;
      }
      const label = start === '/' ? '/' : start.replace(/\/+$/, '');
      visit(found.value, label, lastSegment(start));
    }
    return statusOf(failed);
  },
};
</file>

<file path="src/games/linux/engine/commands/grep.ts">
import { errorText, type ErrorKind } from '../types';
import type { VfsNode } from '../vfs/vfs';
import { joinPath } from '../vfs/path';
import type { Command, CommandContext } from './types';
import { failure, parseArgs, readSources, splitLines, type Source } from './util';

/**
 * Basic regular expressions (grep without -E): `+ ? | ( ) { }` are plain
 * characters, and become operators only with a backslash.
 */
export function basicToJs(pattern: string): string {
  const special = '+?|(){}';
  let source = '';
  for (let i = 0; i < pattern.length; i++) {
    const ch = pattern[i];
    if (ch === '\\' && i + 1 < pattern.length) {
      const next = pattern[++i];
      source += special.includes(next) ? next : `\\${next}`;
    } else {
      source += special.includes(ch) ? `\\${ch}` : ch;
    }
  }
  return source;
}

/** Files under a folder, in name order, for grep -r. */
function collectFiles(
  ctx: CommandContext,
  dir: VfsNode,
  path: string,
  label: string,
  sources: Source[],
): ErrorKind | undefined {
  const { vfs, user } = ctx.shell;
  if (dir.type !== 'dir' || !vfs.can(dir, user, 'r') || !vfs.can(dir, user, 'x')) {
    ctx.err(`grep: ${label || '.'}: Permission denied\n`);
    return 'permission_denied';
  }
  let failed: ErrorKind | undefined;
  const children = [...dir.children.values()].sort((a, b) => (a.name < b.name ? -1 : 1));
  for (const child of children) {
    const childPath = joinPath(path, child.name);
    const childLabel = label ? `${label.replace(/\/+$/, '')}/${child.name}` : child.name;
    if (child.type === 'dir') {
      failed ??= collectFiles(ctx, child, childPath, childLabel, sources);
      continue;
    }
    const read = vfs.readFile(childPath, user);
    if (read.ok) {
      sources.push({ name: childLabel, content: read.value });
    } else {
      ctx.err(`grep: ${childLabel}: ${errorText(read.error)}\n`);
      failed ??= read.error;
    }
  }
  return failed;
}

export const grep: Command = {
  name: 'grep',
  help: {
    usage: 'grep [-i] [-n] [-v] [-c] [-r] pattern [file]...',
    summary: {
      en: 'Find lines that match a pattern. -i ignores case, -n shows line numbers, -v inverts, -c counts, -r searches folders.',
      fr: 'Trouve les lignes qui contiennent un motif. -i ignore la casse, -n numérote, -v inverse, -c compte, -r cherche dans les dossiers.',
    },
  },
  run(ctx) {
    const args = parseArgs(ctx, { flags: 'invrRcE' });
    if (!args) return failure('usage', 2);
    const [pattern, ...files] = args.operands;
    if (pattern === undefined) {
      ctx.err(
        "Usage: grep [OPTION]... PATTERNS [FILE]...\nTry 'grep --help' for more information.\n",
      );
      return failure('usage', 2);
    }
    let regex: RegExp;
    try {
      const source = args.flags.has('E') ? pattern : basicToJs(pattern);
      regex = new RegExp(source, args.flags.has('i') ? 'i' : '');
    } catch {
      ctx.err('grep: Invalid regular expression\n');
      return failure('usage', 2);
    }

    const recursive = args.flags.has('r') || args.flags.has('R');
    let sources: Source[];
    let failed: ErrorKind | undefined;
    let showNames: boolean;
    if (!recursive) {
      ({ sources, failed } = readSources(ctx, files));
      showNames = files.length > 1;
    } else {
      sources = [];
      const operands = files.length ? files : ['.'];
      let searchedDir = false;
      for (const operand of operands) {
        const path = ctx.resolve(operand);
        const found = ctx.shell.vfs.lookup(path, ctx.shell.user);
        if (!found.ok) {
          ctx.err(`grep: ${operand}: ${errorText(found.error)}\n`);
          failed ??= found.error;
        } else if (found.value.type === 'dir') {
          searchedDir = true;
          const label = files.length ? operand : '';
          failed = collectFiles(ctx, found.value, path, label, sources) ?? failed;
        } else {
          const read = readSources(ctx, [operand]);
          sources.push(...read.sources);
          failed ??= read.failed;
        }
      }
      showNames = operands.length > 1 || searchedDir;
    }

    const invert = args.flags.has('v');
    let matched = false;
    for (const source of sources) {
      const prefix = showNames && source.name !== null ? `${source.name}:` : '';
      const hits = splitLines(source.content)
        .map((line, index) => ({ line, number: index + 1 }))
        .filter(({ line }) => regex.test(line) !== invert);
      if (hits.length) matched = true;
      if (args.flags.has('c')) {
        ctx.out(`${prefix}${hits.length}\n`);
        continue;
      }
      for (const hit of hits) {
        ctx.out(`${prefix}${args.flags.has('n') ? `${hit.number}:` : ''}${hit.line}\n`);
      }
    }
    if (failed) return failure(failed, 2);
    return { exitCode: matched ? 0 : 1 };
  },
};
</file>

<file path="src/games/linux/engine/commands/head.ts">
import { errorText } from '../types';
import type { Command, CommandContext, CommandStatus } from './types';
import { failure, joinLines, parseArgs, readSources, splitLines, statusOf } from './util';

/** Shared by head and tail: `-n N`, `-nN` and the old `-N` form. */
export function runLinePicker(
  ctx: CommandContext,
  pick: (lines: string[], count: number) => string[],
): CommandStatus {
  const args = parseArgs(
    ctx,
    { values: 'n' },
    ctx.args.map((arg) => (/^-\d+$/.test(arg) ? `-n${arg.slice(1)}` : arg)),
  );
  if (!args) return failure('usage');
  const countText = args.values.get('n') ?? '10';
  if (!/^\d+$/.test(countText)) {
    ctx.err(`${ctx.name}: invalid number of lines: '${countText}'\n`);
    return failure('usage');
  }
  const count = Number(countText);
  const { sources, failed } = readSources(
    ctx,
    args.operands,
    (operand, kind) => `${ctx.name}: cannot open '${operand}' for reading: ${errorText(kind)}`,
  );
  const blocks = sources.map((source) => {
    const body = joinLines(pick(splitLines(source.content), count));
    if (sources.length < 2) return body;
    return `==> ${source.name ?? 'standard input'} <==\n${body}`;
  });
  ctx.out(blocks.join('\n'));
  return statusOf(failed);
}

export const head: Command = {
  name: 'head',
  help: {
    usage: 'head [-n lines] [file]...',
    summary: {
      en: 'Show the first lines of a file (10 by default).',
      fr: 'Affiche les premières lignes d’un fichier (10 par défaut).',
    },
  },
  run: (ctx) => runLinePicker(ctx, (lines, count) => lines.slice(0, count)),
};
</file>

