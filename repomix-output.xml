// ---------- in a run ----------
function startCampaign(gi) {
  newRun('campaign', gi); go('game');
  Music.play(CHAPTERS[LEVELS[gi].ch].theme);
}
function startEndless(daily) {
  newRun(daily ? 'daily' : 'endless'); go('game');
  Music.play(9);
}
function retry() { if (S.mode === 'campaign') startCampaign(S.gi); else startEndless(S.mode === 'daily'); }
function togglePause() { if (S.phase === 'ready' || S.phase === 'playing') { paused = !paused; UIfocus = 0; } }
const overlayUp = () => paused || (S.phase === 'dead' && S.deadT > 40) || (S.phase === 'delivered' && S.delivT > 60);

function drawGame() {
  drawWorld();
  drawHUD();
  if (!overlayUp() && (S.phase === 'ready' || S.phase === 'playing')) {
    button(908, 10, 38, 32, 'II', togglePause, { font: '10px ' + FD });
  }
  if (S.phase === 'ready' && !paused) drawReady();
  if (paused) drawPaused();
  else if (S.phase === 'dead' && S.deadT > 40) drawDead();
  else if (S.phase === 'delivered' && S.delivT > 60) drawDelivered();
}

function packetSummary(c) {
  const bits = [];
  if (c.showPort) bits.push(`${c.proto} ${c.port}` + (c.showSvc && c.svc ? ' ' + c.svc : ''));
  if (c.vlan) bits.push('VLAN ' + c.vlan);
  if (c.size) bits.push(c.size + ' bytes, DF');
  if (c.cls) bits.push(c.cls.name + ' traffic');
  return bits.join('  ·  ');
}

function drawReady() {
  panel(W / 2 - 330, 140, 660, 250);
  const c = S.cur;
  if (S.mode === 'campaign') {
    const L = LEVELS[S.gi];
    txt(`LEVEL ${levelName(S.gi)}  ${CHAPTERS[L.ch].name}`, W / 2, 170, '14px ' + FD, C.cyan);
  } else txt(S.mode === 'daily' ? 'DAILY PACKET  ' + dayKey() : 'ENDLESS', W / 2, 170, '14px ' + FD, C.cyan);
  txt('Deliver to', W / 2, 204, '500 15px ' + FM, C.dim);
  txt(c.dst != null ? ipStr(c.dst) : c.host, W / 2, 234, '800 30px ' + FM, c.dst != null ? C.green : C.amber);
  const sum = packetSummary(c);
  if (sum) txt(sum, W / 2, 266, '500 15px ' + FM, C.ink);
  const hint = S.mode === 'campaign' ? LEVELS[S.gi].hint : 'Every delivery refills TTL and brings a new kind of packet. How far can you get?';
  wrapText(hint, W / 2, sum ? 300 : 288, 600, 22, '500 15px ' + FM, C.ink);
  if ((T >> 5) % 2) txt('FLAP TO SEND', W / 2, 368, '10px ' + FD, C.amber);
}

function drawPaused() {
  dim(0.6);
  panel(W / 2 - 200, 150, 400, 290);
  txt('PAUSED', W / 2, 190, '20px ' + FD, C.cyan);
  button(W / 2 - 150, 226, 300, 46, 'RESUME', togglePause);
  button(W / 2 - 150, 284, 300, 46, 'RESTART', retry);
  button(W / 2 - 150, 342, 300, 46, 'QUIT TO MENU', () => go('title'));
}

function drawDead() {
  panel(W / 2 - 320, 130, 640, 300, C.red);
  txt(S.deathTitle, W / 2, 170, '22px ' + FD, C.red);
  wrapText(S.deathText, W / 2, 212, 560, 22, '500 16px ' + FM, C.ink);
  if (S.mode === 'campaign') txt(`LEVEL ${levelName(S.gi)}   SCORE ${S.score}`, W / 2, 284, '800 16px ' + FM, C.ink);
  else {
    const best = S.mode === 'daily' ? save.daily[dayKey()] || 0 : save.endlessBest;
    txt(`${S.delivered} PACKETS   SCORE ${S.score}   BEST ${best}`, W / 2, 284, '800 16px ' + FM, C.ink);
    if (S.newBest) txt('NEW BEST!', W / 2, 314, '12px ' + FD, C.amber);
  }
  button(W / 2 - 230, 350, 220, 46, 'RETRY', retry);
  button(W / 2 + 10, 350, 220, 46, 'MENU', () => go('title'));
}

function drawDelivered() {
  panel(W / 2 - 320, 110, 640, 340, C.green);
  txt('DELIVERED', W / 2, 148, '24px ' + FD, C.green);
  for (let k = 0; k < 3; k++) drawStar(W / 2 - 60 + k * 60, 200, 22, k < S.stars);
  const notes = [S.misroutes === 0 ? 'no wrong turns' : `${S.misroutes} wrong turn${S.misroutes > 1 ? 's' : ''}`, S.hits === 0 ? 'no hits' : `${S.hits} hit${S.hits > 1 ? 's' : ''}`];
  txt(notes.join('  ·  '), W / 2, 240, '500 15px ' + FM, C.dim);
  txt(`Delivery 500 + TTL left ${S.ttl} x 100 = +${S.bonus}`, W / 2, 272, '800 16px ' + FM, C.amber);
  txt('SCORE ' + S.score, W / 2, 302, '800 18px ' + FM, C.ink);
  const y = 344, last = S.gi === LAST_LEVEL;
  const nextLabel = last ? 'THE END' : 'NEXT LEVEL';
  const next = () => last ? go('ending') : startCampaign(S.gi + 1);
  button(W / 2 - 300, y, 190, 46, nextLabel, next, { col: C.green });
  button(W / 2 - 95, y, 190, 46, 'RETRY', retry);
  button(W / 2 + 110, y, 190, 46, 'MENU', () => go('campaign'));
  if (!last && LEVELS[S.gi + 1].n === 0) txt(`Chapter ${LEVELS[S.gi + 1].ch + 1} unlocked: ${CHAPTERS[LEVELS[S.gi + 1].ch].name}`, W / 2, 420, '500 14px ' + FM, C.cyan);
}

// ---------- loop ----------
let frozen = false; // screenshot mode stops time
function tick() {
  T++;
  if (frozen) return;
  if (scr === 'title') { updateRun(); if (S.phase === 'dead' && S.deadT > 60) newRun('attract'); }
  else if (scr === 'game' && !paused) updateRun();
}

function render() {
  ctx.setTransform(cv.width / W, 0, 0, cv.height / H, 0, 0);
  ctx.imageSmoothingEnabled = false;
  UI = [];
  if (scr === 'boot') {
    ctx.fillStyle = C.bg; ctx.fillRect(0, 0, W, H);
    txt('LOADING...', W / 2, H / 2, '14px ' + FD, C.cyan);
    return;
  }
    ({ title: drawTitle, campaign: drawCampaign, manual: drawManual, settings: drawSettings,
      game: drawGame, ending: drawEnding })[scr]();
  if (UIfocus >= UI.length) UIfocus = Math.max(0, UI.length - 1);
}

let last = performance.now(), acc = 0;
function frame(now) {
  acc += Math.min(now - last, 250); last = now;
  while (acc >= STEP) { tick(); acc -= STEP; }
  render();
  requestAnimationFrame(frame);
}

// ---------- sizing: fill the window, keep 16:10 ----------
function resize() {
  const s = Math.max(0.1, Math.min(window.innerWidth / W, window.innerHeight / H));
  const cw = Math.floor(W * s), ch = Math.floor(H * s);
  cv.style.width = cw + 'px'; cv.style.height = ch + 'px';
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  cv.width = Math.round(cw * dpr); cv.height = Math.round(ch * dpr);
}
window.addEventListener('resize', resize);

// ---------- input ----------
const toGame = e => { const r = cv.getBoundingClientRect(); return [(e.clientX - r.left) * W / r.width, (e.clientY - r.top) * H / r.height]; };
const hitUI = (x, y) => UI.findIndex(b => x >= b.x && x <= b.x + b.w && y >= b.y && y <= b.y + b.h);
const inFlight = () => scr === 'game' && !paused && (S.phase === 'ready' || S.phase === 'playing');

cv.addEventListener('pointerdown', e => {
  e.preventDefault(); cv.focus(); Snd.init();
  const [x, y] = toGame(e), i = hitUI(x, y);
  if (i >= 0) { UIfocus = i; activate(i); return; }
  if (inFlight()) flap();
});
cv.addEventListener('pointermove', e => {
  if (e.pointerType !== 'mouse') return;
  const [x, y] = toGame(e), i = hitUI(x, y);
  if (i >= 0 && i !== UIfocus && !UI[i].disabled) UIfocus = i;
});

function toggleFullscreen() {
  try {
    if (document.fullscreenElement) document.exitFullscreen();
    else if (document.documentElement.requestFullscreen) document.documentElement.requestFullscreen().catch(() => {});
  } catch (e) { /* not allowed here */ }
}

window.addEventListener('keydown', e => {
  const k = e.code;
  const action = k === 'Space' || k === 'Enter' || k === 'ArrowUp' || k === 'KeyW';
  if (action || k.startsWith('Arrow')) e.preventDefault();
  Snd.init();
  if (k === 'KeyF') return toggleFullscreen();
  if (k === 'KeyM') { save.settings.music = !save.settings.music; persist(); Snd.apply(); return; }
  if (k === 'Escape' || k === 'KeyP') {
    if (scr === 'game') togglePause(); else if (k === 'Escape') back();
    return;
  }
  if (inFlight()) {
    if (action && !e.repeat) flap();
    return;
  }
  if (scr === 'game' && !overlayUp()) return; // dying or arriving: wait for the panel
  if (k === 'ArrowLeft') navigate(-1, 0);
  else if (k === 'ArrowRight') navigate(1, 0);
  else if (k === 'ArrowUp') navigate(0, -1);
  else if (k === 'ArrowDown') navigate(0, 1);
  else if ((k === 'Space' || k === 'Enter') && !e.repeat) activate(UIfocus);
  else if (k === 'Backspace') back();
});

document.addEventListener('visibilitychange', () => {
  if (document.hidden && scr === 'game' && S.phase === 'playing') paused = true;
});

// ---------- boot ----------
// #shot=<what>:<frames> renders one scene for store screenshots: title, campaign, manual, settings, or a level number.
function bootShot(spec) {
  const [what, n] = spec.split(':'), frames = parseInt(n, 10) || 0;
  // an example save, in memory only, so menus show a game in progress
  save.unlocked = LAST_LEVEL;
  for (let i = 0; i < save.unlocked; i++) save.stars[i] = 1 + (i * 7) % 3;
  if (/^\d+$/.test(what)) {
    startCampaign(parseInt(what, 10));
    S.autopilot = true; S.phase = 'playing';
    for (let i = 0; i < frames && S.phase === 'playing'; i++) updateRun();
  } else if (what === 'endless') {
    startEndless(false); S.autopilot = true; S.phase = 'playing';
    for (let i = 0; i < frames && S.phase === 'playing'; i++) updateRun();
  } else {
    go(what);
    if (what === 'campaign' && n) pickCh = parseInt(n, 10);
    for (let i = 0; i < frames; i++) { T++; updateRun(); }
  }
  T = 64; frozen = true;
}

resize();
requestAnimationFrame(frame);
const fontsReady = document.fonts
  ? Promise.race([
      Promise.all([document.fonts.load('20px "Press Start 2P"'), document.fonts.load('800 16px "JetBrains Mono"'), document.fonts.load('500 16px "JetBrains Mono"')]),
      new Promise(r => setTimeout(r, 2500)),
    ]).catch(() => {})
  : Promise.resolve();
Promise.all([loadImages(), fontsReady]).then(() => {
  const m = location.hash.match(/^#shot=(.+)$/);
  if (m) bootShot(decodeURIComponent(m[1]));
  else go('title');
});

</script>
</body>
</html>
