<file path="src/games/SQLGame/content/about.ts">
export const SQL_GAME_ABOUT = {
  en: [
    '## Seek & Command',
    '',
    '### The War is Waged in Code. The Truth is in the Data. Can You Master Both?',
    '',
    '**A detective game. A war game. Both played with SQL.**',
    '',
    'Welcome to a country where every secret, every person, and every city is stored in a database. You are the one who can read it. **Seek & Command** is a browser-based game that teaches SQL by thrusting you into a world of intrigue and strategy. There are no pre-built commands or multiple-choice questions: you write real, functional SQL queries to find hidden targets, command armies, and shape the fate of a nation.',
    '',
    '## The Modes of Play',
    '',
    'Choose your path: the lone analyst or the commanding general.',
    '',
    '### Seek Mode: The Digital Detective',
    '',
    'One person is hidden in a city of thousands. You have a list of clues and a database. Nothing more.',
    '',
    '- **Hunt with Queries:** Follow the trail by filtering, joining, and sorting data to narrow down the suspects.',
    '- **A Race Against the Clock:** The world is not static. In higher-tier cases, your target moves, witnesses appear and disappear, and you must use SQL to track them down.',
    '- **Become the Handler:** Progress from Rookie to Agent to Ghost and finally to Handler. The clues become more complex, calling for window functions, recursive queries, and temporal logic.',
    '- **Daily Challenges:** Take on a new official case every day. Compete on the leaderboard for the fewest turns and rows scanned.',
    '',
    '### Command Mode: The SQL Strategist',
    '',
    'The game world is a map of cities and roads. Factions are vying for control, and your army stands ready. Your orders are `UPDATE` and `INSERT` statements.',
    '',
    '- **Conquer with Code:** Wage campaigns by writing SQL transactions. `BEGIN` your turn, issue your orders, and `COMMIT` to make your moves happen.',
    '- **An Honest War:** The entire rulebook is a SQL file you can read. Every battle, resource gathering action, and unit movement is a visible, auditable query.',
    '- **Tactical Depth:** Manage resources, build armies, and outmaneuver rivals on three distinct, handcrafted maps. Each has a unique objective, from conquering the most cities to controlling a specific region.',
    '- **A Living Campaign:** Your campaign persists. Your army, conquests, and custom-built views (saved queries) carry over from one battle to the next. What you build becomes your own tooling for the war.',
    '',
    '## A Game Built on a Real Engine',
    '',
    'This is not a simulation. Every query you write and every strategy you devise is executed by a **real SQLite database running directly in your browser**.',
    '',
    '- **Authentic Learning:** Learn SQL by doing, with immediate, authentic feedback from the engine. Errors are real SQLite errors, and query performance is measured.',
    '- **The Coach:** A built-in assistant analyzes your queries in real time. It points out common mistakes like `SELECT *`, ambiguous column names, or missing joins, then offers tips for writing more effective queries.',
    '- **Mastering the Craft:** The game tracks your habits, nudges you away from inefficient patterns, and encourages powerful features like `EXISTS` and window functions.',
    '',
    '## More Than a Game: Skills for the Real World',
    '',
    '**Academy Mode** starts with the fundamentals. An interactive handbook teaches everything from a first `SELECT` statement to advanced query optimization.',
    '',
    '**Performance matters:** Ties are broken by the rows scanned per query, encouraging efficient SQL and making performance part of the challenge.',
    '',
    '**Advanced SQL skills:**',
    '',
    '- **Window Functions:** Use `rank()`, `row_number()`, and `lag()` to analyze data over time and rank results.',
    '- **Common Table Expressions (CTEs):** Break down complex problems with `WITH` clauses.',
    '- **Recursive Queries:** Solve pathfinding and shortest-route problems by querying a network of roads.',
    '- **Indexing and Query Plans:** Read query plans and add indexes to make queries run faster, a critical skill for database professionals.',
    '- **PostgreSQL:** Play the final stages on a real PostgreSQL database and learn how it differs from SQLite.',
    '',
    '## For the Players',
    '',
    '- **Play a Friend:** Create a custom case with **Hide a Case**, choose someone to hide, and send a unique code to a friend. You get the same world and target: who is the better detective?',
    '- **A Real Terminal:** Use `Ctrl+Enter` to run queries and the arrow keys to navigate query history. The interface is made for focus and speed.',
    '- **No Account, No Downloads:** Play in your browser. Progress, daily challenges, and settings are saved locally. No sign-ups or fees.',
    '',
    '## Ready to Begin?',
    '',
    'The database is loaded. The first clue is waiting.',
  ].join('\n'),
  fr: [
    '## Seek & Command',
    '',
    '### La guerre se joue en code. La vérité est dans les données. Saurez-vous maîtriser les deux ?',
    '',
    '**Un jeu d’enquête. Un jeu de guerre. Les deux se jouent en SQL.**',
    '',
    'Bienvenue dans un pays où chaque secret, chaque personne et chaque ville est enregistré dans une base de données. C’est à vous de la lire. **Seek & Command** vous apprend le SQL en vous plongeant dans un monde d’intrigues et de stratégie. Pas de commandes toutes faites ni de QCM : écrivez de vraies requêtes SQL pour retrouver des cibles, commander des armées et décider du destin d’une nation.',
    '',
    '## Les modes de jeu',
    '',
    'Choisissez votre voie : analyste solitaire ou général en chef.',
    '',
    '### Seek : le détective numérique',
    '',
    'Une personne se cache dans une ville de milliers d’habitants. Vous avez des indices et une base de données. Rien de plus.',
    '',
    '- **Enquêtez avec des requêtes :** suivez les pistes en filtrant, en joignant et en triant les données pour réduire la liste des suspects.',
    '- **Une course contre la montre :** le monde est en mouvement. Dans les affaires avancées, la cible se déplace, les témoins apparaissent ou disparaissent, et vos requêtes SQL doivent la suivre.',
    '- **Devenez Handler :** progressez de Rookie à Agent, puis Ghost et enfin Handler. Les indices se complexifient et demandent des fonctions de fenêtrage, des requêtes récursives et une logique temporelle.',
    '- **Défis quotidiens :** résolvez chaque jour une nouvelle affaire officielle. Grimpez au classement avec le moins de tours et de lignes parcourues possible.',
    '',
    '### Command : le stratège SQL',
    '',
    'Le monde est une carte de villes et de routes. Les factions se disputent le pouvoir et votre armée est prête. Vos ordres prennent la forme de requêtes `UPDATE` et `INSERT`.',
    '',
    '- **Conquérez avec du code :** menez vos campagnes avec des transactions SQL. `BEGIN` lance votre tour, donnez vos ordres, puis `COMMIT` pour exécuter vos mouvements.',
    '- **Une guerre transparente :** tout le livre de règles est un fichier SQL consultable. Chaque bataille, collecte de ressources et déplacement d’unité est une requête visible et vérifiable.',
    '- **De la profondeur tactique :** gérez les ressources, formez des armées et prenez l’avantage sur trois cartes conçues à la main. Chacune a son objectif : conquérir le plus de villes ou contrôler une région précise.',
    '- **Une campagne vivante :** votre campagne persiste. Armée, conquêtes et vues personnalisées (requêtes enregistrées) vous suivent d’une bataille à l’autre. Vos outils deviennent les vôtres.',
    '',
    '## Un jeu propulsé par un vrai moteur',
    '',
    'Ce n’est pas une simulation : chaque requête et chaque stratégie est exécutée par une **véritable base SQLite, directement dans votre navigateur**.',
    '',
    '- **Un apprentissage concret :** apprenez le SQL en pratiquant et recevez un retour immédiat du moteur. Les erreurs sont de vraies erreurs SQLite et les performances de vos requêtes sont mesurées.',
    '- **Le coach :** un assistant intégré analyse vos requêtes en temps réel. Il repère les erreurs courantes comme `SELECT *`, les noms de colonnes ambigus ou les jointures manquantes, puis conseille des requêtes plus efficaces.',
    '- **La maîtrise du métier :** le jeu suit vos habitudes, vous signale les pratiques peu efficaces et vous encourage à utiliser des outils puissants comme `EXISTS` et les fonctions de fenêtrage.',
    '',
    '## Plus qu’un jeu : des compétences utiles en pratique',
    '',
    '**Le mode Academy** enseigne les bases dans un manuel interactif, du premier `SELECT` jusqu’à l’optimisation avancée des requêtes.',
    '',
    '**Les performances comptent :** les égalités sont départagées par le nombre de lignes parcourues par requête. Écrire du SQL efficace fait partie du défi.',
    '',
    '**Les techniques SQL avancées :**',
    '',
    '- **Fonctions de fenêtrage :** utilisez `rank()`, `row_number()` et `lag()` pour analyser les données dans le temps et classer des résultats.',
    '- **Expressions de table communes (CTE) :** décomposez les problèmes complexes avec les clauses `WITH`.',
    '- **Requêtes récursives :** trouvez des chemins et des itinéraires courts en interrogeant un réseau routier.',
    '- **Index et plans de requête :** lisez les plans et ajoutez des index pour accélérer les requêtes, une compétence essentielle en base de données.',
    '- **PostgreSQL :** les derniers niveaux utilisent un vrai moteur PostgreSQL et vous apprennent ses différences avec SQLite.',
    '',
    '## Pour les joueurs',
    '',
    '- **Jouez avec un ami :** créez une affaire avec **Hide a Case**, choisissez une personne à cacher et envoyez un code unique à un ami. Vous aurez le même monde et la même cible : qui mènera la meilleure enquête ?',
    '- **Un vrai terminal :** lancez les requêtes avec `Ctrl+Enter` et parcourez votre historique avec les flèches du clavier. L’interface est pensée pour rester concentré et aller vite.',
    '- **Sans compte ni téléchargement :** jouez dans le navigateur. Progression, défis quotidiens et réglages sont enregistrés localement. Pas d’inscription ni de frais.',
    '',
    '## Prêt à commencer ?',
    '',
    'La base de données est chargée. Le premier indice vous attend.',
  ].join('\n'),
} as const;
</file>

<file path="src/games/SQLGame/audio.js">
(() => {
  const MENU_ITEM = '.menu .menu-row';
  const FEEDBACK = '.notice.is-good, .notice.is-bad';
  const playedFeedback = new WeakSet();
  let context = null;
  let master = null;
  let musicStarted = false;
  let lastHover = null;
  let lastHoverAt = 0;
  let noteIndex = 0;

  function volume() {
    try {
      const settings = JSON.parse(localStorage.getItem('settings') || '{}');
      return typeof settings.sound === 'number'
        ? Math.max(0, Math.min(1, settings.sound))
        : 0.7;
    } catch {
      return 0.7;
    }
  }

  function audio() {
    if (!window.AudioContext || volume() === 0) return null;
    if (context === null) {
      context = new AudioContext();
      master = context.createGain();
      master.gain.value = volume();
      master.connect(context.destination);
    }
    if (context.state === 'suspended') void context.resume().catch(() => {});
    return context;
  }

  function tone(frequency, duration, options = {}) {
    const ctx = audio();
    if (!ctx || !master) return;

    const start = ctx.currentTime + (options.delay || 0);
    const oscillator = ctx.createOscillator();
    const envelope = ctx.createGain();
    oscillator.type = options.wave || 'sine';
    oscillator.frequency.setValueAtTime(frequency, start);
    envelope.gain.setValueAtTime(0.0001, start);
    envelope.gain.exponentialRampToValueAtTime(options.gain || 0.045, start + 0.012);
    envelope.gain.exponentialRampToValueAtTime(0.0001, start + duration);
    oscillator.connect(envelope).connect(master);
    oscillator.start(start);
    oscillator.stop(start + duration + 0.02);
  }

  function playNotes(notes, spacing, duration, gain, wave = 'sine') {
    notes.forEach((frequency, index) => {
      tone(frequency, duration, { delay: index * spacing, gain, wave });
    });
  }

  function startMusic() {
    if (musicStarted || !audio()) return;
    musicStarted = true;

    const ctx = context;
    const filter = ctx.createBiquadFilter();
    const hum = ctx.createGain();
    filter.type = 'lowpass';
    filter.frequency.value = 230;
    hum.gain.value = 0.12;
    filter.connect(hum).connect(master);

    [55, 82.41].forEach((frequency, index) => {
      const oscillator = ctx.createOscillator();
      oscillator.type = index === 0 ? 'sine' : 'triangle';
      oscillator.frequency.value = frequency;
      oscillator.detune.value = index === 0 ? -3 : 4;
      oscillator.connect(filter);
      oscillator.start();
    });

    const lfo = ctx.createOscillator();
    const lfoDepth = ctx.createGain();
    lfo.frequency.value = 0.08;
    lfoDepth.gain.value = 22;
    lfo.connect(lfoDepth).connect(filter.frequency);
    lfo.start();

    const motif = [220, 261.63, 196, 233.08, 174.61, 196];
    function step() {
      if (document.hidden || volume() === 0) return;
      tone(motif[noteIndex % motif.length], 1.25, {
        gain: 0.022,
        wave: noteIndex % 3 === 0 ? 'triangle' : 'sine',
      });
      noteIndex += 1;
    }
    step();
    window.setInterval(step, 2400);
  }

  function unlockAudio() {
    if (volume() === 0) return;
    const ctx = audio();
    if (!ctx) return;
    startMusic();
  }

  function menuItem(target) {
    return target instanceof Element ? target.closest(MENU_ITEM) : null;
  }

  function playHover(item) {
    const now = performance.now();
    if (item === lastHover && now - lastHoverAt < 140) return;
    lastHover = item;
    lastHoverAt = now;
    playNotes([740, 988], 0.035, 0.075, 0.028, 'triangle');
  }

  document.addEventListener('pointerover', (event) => {
    const item = menuItem(event.target);
    if (!item || (event.relatedTarget instanceof Node && item.contains(event.relatedTarget))) return;
    playHover(item);
  });

  document.addEventListener('focusin', (event) => {
    const item = menuItem(event.target);
    if (item) playHover(item);
  });

  document.addEventListener('pointerdown', (event) => {
    if (event.button !== 0) return;
    unlockAudio();
    if (menuItem(event.target)) playNotes([523.25, 783.99], 0.045, 0.11, 0.055, 'triangle');
  });

  document.addEventListener('click', (event) => {
    if (event.detail !== 0 || !menuItem(event.target)) return;
    unlockAudio();
    playNotes([523.25, 783.99], 0.045, 0.11, 0.055, 'triangle');
  });

  function playFeedback(node) {
    if (!(node instanceof Element)) return;
    const notice = node.matches(FEEDBACK) ? node : node.closest(FEEDBACK);
    if (!notice || playedFeedback.has(notice)) return;
    playedFeedback.add(notice);

    if (notice.classList.contains('is-good')) {
      playNotes([659.25, 783.99, 987.77, 1174.66], 0.075, 0.2, 0.065);
    } else {
      playNotes([220, 174.61, 146.83], 0.1, 0.22, 0.055, 'triangle');
    }
  }

  const observer = new MutationObserver((records) => {
    for (const record of records) {
      if (record.type === 'attributes') playFeedback(record.target);
      for (const node of record.addedNodes) {
        playFeedback(node);
        if (node instanceof Element) node.querySelectorAll(FEEDBACK).forEach(playFeedback);
      }
    }
  });
  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['class'],
    childList: true,
    subtree: true,
  });

  document.addEventListener('keydown', unlockAudio, { once: true });
  document.addEventListener('pointerdown', unlockAudio, { once: true });
  document.addEventListener('visibilitychange', () => {
    if (!context) return;
    if (document.hidden) void context.suspend().catch(() => {});
    else if (volume() > 0) void context.resume().catch(() => {});
  });

  window.setInterval(() => {
    if (!context || !master) return;
    master.gain.setTargetAtTime(volume(), context.currentTime, 0.08);
  }, 500);
})();
