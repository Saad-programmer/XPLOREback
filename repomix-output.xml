<file path="src/shared/site/Starfield.tsx">
'use client';

import { useEffect, useRef } from 'react';
import { useReducedMotion } from '../ui/use-reduced-motion';
import { generateStarfield, STAR_TILE, starPosition, twinkle } from './stars';
import styles from './Starfield.module.css';

/** The drift is slow: 30 frames per second look the same and cost half. */
const FRAME_MS = 1000 / 30;

interface ShootingStar {
  x: number;
  y: number;
  vx: number;
  vy: number;
  life: number;
}

/**
 * Background of the website pages: deep brand blue, slow nebula glows (CSS)
 * and a canvas of drifting, twinkling stars with a rare shooting star.
 * Stops when the tab is hidden or the page is left (Next.js hides visited
 * pages and cleans up their effects); one still frame with reduced motion.
 *
 * `sky={false}` draws only the stars, on a transparent layer (title screen,
 * over the capsule art). `paused` freezes it, e.g. while a mission loads.
 */
export function Starfield({ sky = true, paused = false }: { sky?: boolean; paused?: boolean }) {
  const canvasRef = useRef<HTMLCanvasElement>(null);
  // Survives pause and resume, so the stars do not jump back to their start.
  const elapsedRef = useRef(0);
  const reducedMotion = useReducedMotion();

  useEffect(() => {
    const canvas = canvasRef.current;
    const ctx = canvas?.getContext('2d');
    if (!canvas || !ctx) return;

    const stars = generateStarfield();
    let width = 0;
    let height = 0;
    let dpr = 1;
    let frame = 0;
    let last = 0;
    let elapsed = elapsedRef.current;
    let shooting: ShootingStar | null = null;
    // Random is fine here: this runs in an effect, never during render.
    let nextShootingStar = 8 + Math.random() * 10;

    const resize = () => {
      width = window.innerWidth;
      height = window.innerHeight;
      dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
    };

    const draw = (dt: number) => {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, width, height);
      const scrollY = window.scrollY;

      for (const star of stars) {
        const { x, y } = starPosition(star, elapsed, scrollY);
        const [r, g, b] = star.color;
        ctx.fillStyle = `rgba(${r},${g},${b},${twinkle(star, elapsed)})`;
        // Repeat the tile across the screen.
        for (let tx = x; tx < width; tx += STAR_TILE) {
          for (let ty = y; ty < height; ty += STAR_TILE) {
            const s = Math.round(star.size);
            if (star.sparkle) {
              // A pixel "+": the centre and its four neighbours.
              ctx.fillRect(Math.round(tx) - s, Math.round(ty), s * 3, s);
              ctx.fillRect(Math.round(tx), Math.round(ty) - s, s, s * 3);
            } else {
              ctx.fillRect(tx, ty, star.size, star.size);
            }
          }
        }
      }

      if (reducedMotion) return;
      if (!shooting && elapsed > nextShootingStar) {
        const angle = Math.PI * (0.08 + Math.random() * 0.1);
        shooting = {
          x: width * (0.05 + Math.random() * 0.6),
          y: height * Math.random() * 0.4,
          vx: Math.cos(angle) * 700,
          vy: Math.sin(angle) * 700,
          life: 1,
        };
        nextShootingStar = elapsed + 18 + Math.random() * 20;
      }
      if (shooting) {
        shooting.x += shooting.vx * dt;
        shooting.y += shooting.vy * dt;
        shooting.life -= dt * 1.5;
        const tail = 0.14;
        const gradient = ctx.createLinearGradient(
          shooting.x,
          shooting.y,
          shooting.x - shooting.vx * tail,
          shooting.y - shooting.vy * tail,
        );
        gradient.addColorStop(0, `rgba(222,230,255,${Math.max(0, shooting.life) * 0.8})`);
        gradient.addColorStop(1, 'rgba(122,162,247,0)');
        ctx.strokeStyle = gradient;
        ctx.lineWidth = 1.4;
        ctx.beginPath();
        ctx.moveTo(shooting.x, shooting.y);
        ctx.lineTo(shooting.x - shooting.vx * tail, shooting.y - shooting.vy * tail);
        ctx.stroke();
        if (shooting.life <= 0) shooting = null;
      }
    };

    const tick = (now: number) => {
      frame = requestAnimationFrame(tick);
      if (now - last < FRAME_MS) return;
      const dt = Math.min(0.1, (now - last) / 1000);
      last = now;
      elapsed += dt;
      elapsedRef.current = elapsed;
      draw(dt);
    };

    const running = () => !reducedMotion && !paused && document.visibilityState === 'visible';
    const start = () => {
      if (frame || !running()) return;
      last = performance.now();
      frame = requestAnimationFrame(tick);
      canvas.dataset.running = 'true';
    };
    const stop = () => {
      cancelAnimationFrame(frame);
      frame = 0;
      canvas.dataset.running = 'false';
    };
    const redraw = () => {
      // Still frame (reduced motion): follow resizes and the scroll by hand.
      if (!frame) draw(0);
    };
    const onResize = () => {
      resize();
      redraw();
    };
    const onVisibility = () => (running() ? start() : stop());

    resize();
    draw(0);
    stop();
    start();
    window.addEventListener('resize', onResize);
    window.addEventListener('scroll', redraw, { passive: true });
    document.addEventListener('visibilitychange', onVisibility);
    return () => {
      stop();
      window.removeEventListener('resize', onResize);
      window.removeEventListener('scroll', redraw);
      document.removeEventListener('visibilitychange', onVisibility);
    };
  }, [reducedMotion, paused]);

  return (
    <div className={sky ? styles.sky : styles.overlay} aria-hidden="true">
      {sky && <div className={styles.nebula} data-still={reducedMotion || undefined} />}
      <canvas ref={canvasRef} className={styles.stars} />
    </div>
  );
}
</file>

<file path="src/shared/site/stars.ts">
/**
 * The website background, as data: a calm field of stars drifting through the
 * brand's deep blue, in the spirit of the capsule art's space.
 *
 * Stars live on a square tile that repeats across the screen, so the density is
 * the same on a phone and on a wide monitor, and nothing is generated again on
 * resize. Three layers at different depths drift and follow the scroll at
 * different speeds (parallax). A few near stars are pixel sparkles, like the
 * mosaic of the Xplore X.
 *
 * This file is pure (no DOM), so it is unit-tested; Starfield.tsx draws it.
 */
import { createRng } from '../random';

/** Size of the repeating star tile, in CSS pixels. */
export const STAR_TILE = 900;

/** Drift speed of the nearest layer, in CSS pixels per second (far layers are slower). */
export const DRIFT_SPEED = { x: -7, y: -3 };

export interface FieldStar {
  /** Position in the tile, 0 to STAR_TILE. */
  x: number;
  y: number;
  /** 0 (far, slow) to 1 (near, fast). */
  depth: number;
  size: number;
  alpha: number;
  /** Twinkles per second (radians). */
  twinkleSpeed: number;
  phase: number;
  /** Drawn as a small pixel "+" instead of a dot. */
  sparkle: boolean;
  color: readonly [number, number, number];
}

const STAR_COLORS = {
  white: [222, 230, 255],
  blue: [122, 162, 247],
  violet: [187, 154, 247],
  pink: [247, 161, 196],
} as const;

/** [count, depth, size] per layer: far and many, near and few. */
const LAYERS: [number, number, number][] = [
  [150, 0.15, 1],
  [60, 0.4, 1.5],
  [14, 0.8, 2],
];

export function generateStarfield(seed = 2026): FieldStar[] {
  const rng = createRng(seed);
  return LAYERS.flatMap(([count, depth, size]) =>
    Array.from({ length: count }, () => {
      const near = depth > 0.5;
      const sparkle = near && rng() < 0.6;
      const tint = rng();
      const color = !near
        ? STAR_COLORS.white
        : tint < 0.5
          ? STAR_COLORS.blue
          : tint < 0.8
            ? STAR_COLORS.violet
            : STAR_COLORS.pink;
      return {
        x: rng() * STAR_TILE,
        y: rng() * STAR_TILE,
        depth,
        size: size * (0.7 + rng() * 0.6),
        alpha: (near ? 0.55 : 0.25) + rng() * 0.4,
        twinkleSpeed: 0.4 + rng() * 1.6,
        phase: rng() * Math.PI * 2,
        sparkle,
        color,
      };
    }),
  );
}

/** Where a star is on screen at `timeS`, scrolled by `scrollY`: always inside the tile. */
export function starPosition(star: FieldStar, timeS: number, scrollY: number) {
  const wrap = (value: number) => ((value % STAR_TILE) + STAR_TILE) % STAR_TILE;
  return {
    x: wrap(star.x + DRIFT_SPEED.x * star.depth * timeS),
    y: wrap(star.y + DRIFT_SPEED.y * star.depth * timeS - scrollY * star.depth * 0.3),
  };
}

/** Brightness between 0.55 and 1 times the star's alpha. */
export function twinkle(star: FieldStar, timeS: number): number {
  return star.alpha * (0.775 + 0.225 * Math.sin(timeS * star.twinkleSpeed + star.phase));
}
</file>

<file path="tests/unit/linux/game-logic.test.ts">
import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
import { complete } from '@/src/games/linux/completion';
import { getMission, memes, reactions } from '@/src/games/linux/content';
import { createGameStore } from '@/src/games/linux/game-store';
import { buildMapTree, initialKnown, revealAfterLine } from '@/src/games/linux/map-model';
import type { EventOf } from '@/src/games/linux/engine/events';
import { createProgressStore } from '@/src/shared/progress/progress-store';
import { MockBridge } from '@/src/shared/bridge/mock-bridge';
import { memoryStore } from '@/src/shared/storage';
import { HOME, makeShell } from './helpers';

const fs = {
  [HOME]: {
    'notes.txt': 'n',
    'notebook.md': 'b',
    '.secret': 's',
    docs: { type: 'dir' as const, children: { 'a.txt': 'a', deep: { type: 'dir' as const } } },
  },
};

describe('Tab completion', () => {
  const shell = makeShell(fs);

  it('completes command names', () => {
    expect(complete(shell, 'who')).toEqual({ line: 'whoami ', candidates: [] });
    expect(complete(shell, 'ls | so')).toEqual({ line: 'ls | sort ', candidates: [] });
    expect(complete(shell, 'h').candidates).toEqual(['head', 'help', 'history']);
  });

  it('completes files, folders and paths', () => {
    expect(complete(shell, 'cat notes')).toEqual({ line: 'cat notes.txt ', candidates: [] });
    expect(complete(shell, 'cd do')).toEqual({ line: 'cd docs/', candidates: [] });
    expect(complete(shell, 'cat docs/a')).toEqual({ line: 'cat docs/a.txt ', candidates: [] });
    expect(complete(shell, 'cat not')).toEqual({
      line: 'cat note',
      candidates: ['notebook.md', 'notes.txt'],
    });
  });

  it('only completes hidden files after a dot', () => {
    expect(complete(shell, 'cat .s')).toEqual({ line: 'cat .secret ', candidates: [] });
    expect(complete(shell, 'cat s')).toEqual({ line: 'cat s', candidates: [] });
  });
});

describe('live map', () => {
  const reveal = (line: string, shell = makeShell(fs), known = initialKnown(HOME)) => {
    const cwdBefore = shell.cwd();
    let command: EventOf<'command'> | null = null;
    const changes: EventOf<'fs_changed'>[] = [];
    shell.events.on('command', (e) => (command = e));
    shell.events.on('fs_changed', (e) => changes.push(e));
    shell.run(line);
    return revealAfterLine(
      known,
      shell.vfs,
      { cwdBefore, cwdAfter: shell.cwd(), home: HOME },
      command,
      changes,
    );
  };

  it('starts with only the path to the current folder', () => {
    const shell = makeShell(fs);
    const tree = buildMapTree(shell.vfs, initialKnown(HOME));
    expect(tree.children[0].children[0]).toMatchObject({
      path: HOME,
      unexplored: true,
      children: [],
    });
  });

  it('reveals listed files, hidden ones only with -a', () => {
    expect([...reveal('ls')].sort()).toEqual(
      ['/', '/home', HOME, `${HOME}/docs`, `${HOME}/notebook.md`, `${HOME}/notes.txt`].sort(),
    );
    expect(reveal('ls -a')).toContain(`${HOME}/.secret`);
  });

  it('reveals folders walked into and files read or created', () => {
    expect(reveal('cd docs/deep')).toContain(`${HOME}/docs/deep`);
    expect(reveal('cat docs/a.txt')).toContain(`${HOME}/docs/a.txt`);
    expect(reveal('touch new.txt')).toContain(`${HOME}/new.txt`);
    expect(reveal('find docs')).toContain(`${HOME}/docs/deep`);
  });

  it('forgets deleted files and follows moved ones', () => {
    const shell = makeShell(fs);
    const known = reveal('ls', shell);
    expect(reveal('rm notes.txt', shell, known)).not.toContain(`${HOME}/notes.txt`);
    const moved = reveal('mv notebook.md docs', shell, known);
    expect(moved).toContain(`${HOME}/docs/notebook.md`);
    expect(moved).not.toContain(`${HOME}/notebook.md`);
  });
});

describe('game session', () => {
  beforeEach(() => vi.useFakeTimers());
  afterEach(() => vi.useRealTimers());

  function setup(missionId = 'archive-hidden-scroll') {
    const store = memoryStore();
    const progress = createProgressStore({ bridge: new MockBridge(store), store });
    const game = createGameStore({ mission: getMission(missionId)!, progress, reactions, memes });
    return { store, progress, game, state: () => game.getState() };
  }

  it('starts with the briefing', async () => {
    const { state } = setup();
    await state().start();
    expect(state()).toMatchObject({
      phase: 'playing',
      cwd: HOME,
      dialogue: { kind: 'briefing', index: 0 },
    });
    state().nextLine();
    expect(state().dialogue?.index).toBe(1);
  });

  it('plays mission 3: hints, reaction, wrong and right password, points', async () => {
    const { state, progress } = setup();
    await state().start();
    state().showHint();
    expect(state()).toMatchObject({ hintsUsed: 1, dialogue: { kind: 'hint' } });

    state().run('ls -a');
    expect(state().known).toContain(`${HOME}/.secret_scroll`);
    const password = state().run('cat .secret_scroll')!.stdout.trim();

    expect(await state().submitPassword('nope')).toBe(false);
    expect(state()).toMatchObject({ wrongPassword: true, dialogue: { kind: 'info' } });

    expect(await state().submitPassword(password)).toBe(true);
    expect(state()).toMatchObject({ phase: 'won', dialogue: { kind: 'victory' } });
    expect(state().victory?.outcome).toMatchObject({ kind: 'done', result: { pointsAwarded: 10 } });
    expect(progress.getState().player?.points).toBe(10);
  });

  it('shows mission reactions', async () => {
    const { state } = setup();
    await state().start();
    state().run('rm .secret_scroll');
    expect(state().dialogue).toMatchObject({ kind: 'reaction', lines: [{ mood: 'shocked' }] });
  });

  it('comes back after a refresh with the map and folder, and restarts fresh', async () => {
    const first = setup('wake-up-first-door');
    await first.state().start();
    first.state().run('ls');
    first.state().run('cd door-2');

    const progress = createProgressStore({
      bridge: new MockBridge(first.store),
      store: first.store,
    });
    const again = createGameStore({
      mission: getMission('wake-up-first-door')!,
      progress,
      reactions,
      memes,
    });
    await again.getState().start();
    expect(again.getState()).toMatchObject({ cwd: `${HOME}/door-2`, dialogue: { kind: 'info' } });
    expect(again.getState().known).toContain(`${HOME}/door-1`);

    await again.getState().start({ fresh: true });
    expect(again.getState().cwd).toBe(HOME);
    expect(again.getState().dialogue?.kind).toBe('briefing');
  });
});
