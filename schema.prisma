  tenantId            String                         @db.Uuid
  userId              String                         @db.Uuid
  roleId              String                         @db.Uuid
  status              MembershipStatus               @default(INVITED)
  assignedAt          DateTime                       @default(now())
  /// Title shown instead of the role's name ("Designer"…); the role still decides the access.
  displayTitle        String?
  tenant              Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                Role                           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permissionOverrides MembershipPermissionOverride[]

  @@id([tenantId, userId])
  @@index([userId, status])
  @@index([roleId])
}

model TenantInvitation {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @db.Uuid
  email               String
  displayName         String
  roleKey             String    @default("ADMIN")
  /// Title shown once accepted (copied to the membership's displayTitle).
  displayTitle        String?
  permissionOverrides Json?
  tokenHash           String    @unique
  expiresAt           DateTime
  acceptedAt          DateTime?
  createdAt           DateTime  @default(now())
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
  @@index([expiresAt, acceptedAt])
}

model RecruitmentTeam {
  id          String                  @id @default(uuid()) @db.Uuid
  tenantId    String                  @db.Uuid
  key         String
  name        String
  description String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members     RecruitmentTeamMember[]

  @@unique([tenantId, key])
  @@index([tenantId, createdAt])
}

model RecruitmentTeamMember {
  teamId     String           @db.Uuid
  userId     String           @db.Uuid
  assignedAt DateTime         @default(now())
  team       RecruitmentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId, assignedAt])
}

enum RecruitmentCampaignStatus {
  DRAFT
  OPEN
  CLOSED
}

model RecruitmentCampaign {
  id          String                    @id @default(uuid()) @db.Uuid
  tenantId    String                    @db.Uuid
  name        String
  status      RecruitmentCampaignStatus @default(DRAFT)
  startsAt    DateTime?
  endsAt      DateTime?
  createdById String                    @db.Uuid
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  tenant      Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   User                      @relation("RecruitmentCampaignCreator", fields: [createdById], references: [id], onDelete: Restrict)
  /// Set when a holder of club.recruitment.close closes it: evaluations lock, the jury gets its rewards.
  closedAt    DateTime?
  closedById  String?                   @db.Uuid
  closedBy    User?                     @relation("RecruitmentCampaignCloser", fields: [closedById], references: [id], onDelete: SetNull)
  candidates  RecruitmentCandidate[]
  xpEntries   MemberXpEntry[]
  badges      MemberBadge[]

  @@index([tenantId, status, createdAt])
}

model RecruitmentCandidate {
  id             String                   @id @default(uuid()) @db.Uuid
  tenantId       String                   @db.Uuid
  campaignId     String                   @db.Uuid
  registrationId String?                  @db.Uuid
  fullName       String
  email          String?
  promotion      String?
  studyProgram   String?
  createdAt      DateTime                 @default(now())
  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign       RecruitmentCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  registration   ClubRegistration?        @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  evaluations    RecruitmentEvaluation[]

  @@unique([campaignId, email])
  @@index([tenantId, campaignId, createdAt])
}

model RecruitmentEvaluation {
  id           String               @id @default(uuid()) @db.Uuid
  candidateId  String               @db.Uuid
  evaluatorId  String               @db.Uuid
  formType     String
  scores       Json
  decision     String
  cellPriorities String[] @default([])
  selectedPost String?
  remarks      String?
  evaluatedAt  DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  candidate    RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  evaluator    User                 @relation(fields: [evaluatorId], references: [id], onDelete: Restrict)

  @@unique([candidateId, evaluatorId, formType])
  @@index([candidateId, evaluatedAt])
}

/// Experience points (XP): earned for work done for the club, never spent — unlike club points, which
/// members give away as gifts and lose to penalties. One entry per reward; a person's XP is the sum.
model MemberXpEntry {
  id          String               @id @default(uuid()) @db.Uuid
  tenantId    String               @db.Uuid
  userId      String               @db.Uuid
  amount      Int
  /// What the XP is for, e.g. RECRUITMENT_JURY.
  reason      String
  label       String
  campaignId  String?              @db.Uuid
  awardedById String?              @db.Uuid
  createdAt   DateTime             @default(now())
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User                 @relation("MemberXpEntries", fields: [userId], references: [id], onDelete: Cascade)
  awardedBy   User?                @relation("MemberXpAwards", fields: [awardedById], references: [id], onDelete: SetNull)
  campaign    RecruitmentCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@unique([campaignId, userId, reason])
  @@index([tenantId, userId, createdAt])
}

/// A badge a person earned (e.g. "Jury de recrutement 2026", gold), shown on their profile.
model MemberBadge {
  id          String               @id @default(uuid()) @db.Uuid
  tenantId    String               @db.Uuid
  userId      String               @db.Uuid
  /// Stable per badge kind and edition, e.g. recruitment-jury-2026: a person holds each once.
  key         String
  /// GOLD, SILVER or BRONZE for tiered badges.
  tier        String?
  label       String
  campaignId  String?              @db.Uuid
  awardedById String?              @db.Uuid
  awardedAt   DateTime             @default(now())
  /// What earned it (evaluations, rank…), shown with the badge.
  metadata    Json?
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User                 @relation("MemberBadges", fields: [userId], references: [id], onDelete: Cascade)
  awardedBy   User?                @relation("MemberBadgeAwards", fields: [awardedById], references: [id], onDelete: SetNull)
  campaign    RecruitmentCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@unique([tenantId, userId, key])
  @@index([userId, awardedAt])
}

model PlatformInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  platformId  String    @db.Uuid
  email       String
  displayName String
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  platform    Platform  @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@index([platformId, email])
  @@index([expiresAt, acceptedAt])
}

model Module {
  id          String         @id @default(uuid()) @db.Uuid
  platformId  String         @db.Uuid
  key         String
  version     String
  label       String
  isAvailable Boolean        @default(true)
  createdAt   DateTime       @default(now())
  platform    Platform       @relation(fields: [platformId], references: [id], onDelete: Cascade)
  tenants     TenantModule[]
  planModules PlanModule[]

  @@unique([platformId, key])
  @@index([platformId, isAvailable])
}

model TenantModule {
  tenantId  String   @db.Uuid
  moduleId  String   @db.Uuid
  enabled   Boolean  @default(true)
  enabledAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([tenantId, moduleId])
  @@index([moduleId, enabled])
}

model Plan {
  id            String               @id @default(uuid()) @db.Uuid
  platformId    String               @db.Uuid
  key           String
  name          String
  priceMinor    Int                  @default(0)
  currency      String               @default("USD")
  interval      BillingInterval      @default(MONTHLY)
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  platform      Platform             @relation(fields: [platformId], references: [id], onDelete: Cascade)
  modules       PlanModule[]
  subscriptions TenantSubscription[]

  @@unique([platformId, key])
}

model PlanModule {
  planId   String @db.Uuid
  moduleId String @db.Uuid
  plan     Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([planId, moduleId])
}

model TenantSubscription {
  id                     String             @id @default(uuid()) @db.Uuid
  tenantId               String             @db.Uuid
  planId                 String             @db.Uuid
  status                 SubscriptionStatus @default(TRIALING)
  isCurrent              Boolean            @default(true)
  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  tenant                 Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan                   Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([tenantId, isCurrent])
  @@index([provider, providerSubscriptionId])
}

model TenantSetting {
  tenantId  String   @db.Uuid
  key       String
  value     Json
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key])
}

model TenantBranding {
  tenantId     String   @id @db.Uuid
  logoUrl      String?
  primaryColor String?
  accentColor  String?
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model User {
  id                      String                       @id @default(uuid()) @db.Uuid
  email                   String                       @unique
  normalizedEmail         String                       @unique
  displayName             String?
  profilePhotoUrl         String?
  profilePhotoPublicId    String?
  profilePhotoSource      String?
  profilePhotoOptOut      Boolean                      @default(false)
  /// Set when the user disconnects Google: Google sign-in then no longer re-links by email
  /// (cleared when they connect Google again from their settings).
  googleDisconnectedAt    DateTime?
  /// Which notifications this person wants, e.g. { "birthdays": false }; a missing key means on.
  notificationPreferences Json                         @default("{}")
  passwordHash            String?
  emailVerifiedAt         DateTime?
  loginVerifiedAt         DateTime?
  totpSecret              String?
  totpEnabled             Boolean                      @default(false)
  isActive                Boolean                      @default(true)
  failedLoginCount        Int                          @default(0)
  lockedUntil             DateTime?
  lastLoginAt             DateTime?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  roles                   UserRole[]
  sessions                AuthSession[]
  auditEvents             AuditLog[]
  platformMemberships     PlatformMembership[]
  tenantMemberships       TenantMembership[]
  notifications           Notification[]
  pushDevices             PushDevice[]
  subscriptionPayments    SubscriptionPayment[]
  subscriptionTransfers   SubscriptionTransferRecord[]
  identities              AuthIdentity[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  loginVerificationCodes  LoginVerificationCode[]
  clubRegistrations       ClubRegistration[]
  feedback                ClubFeedback[]
  spaceProfiles           ClubSpaceProfile[]
  recruitmentTeamMemberships RecruitmentTeamMember[]
  recruitmentCampaignsCreated RecruitmentCampaign[] @relation("RecruitmentCampaignCreator")
  recruitmentCampaignsClosed RecruitmentCampaign[] @relation("RecruitmentCampaignCloser")
  xpEntries               MemberXpEntry[] @relation("MemberXpEntries")
  xpAwarded               MemberXpEntry[] @relation("MemberXpAwards")
  badges                  MemberBadge[]   @relation("MemberBadges")
  badgesAwarded           MemberBadge[]   @relation("MemberBadgeAwards")
  recruitmentEvaluations  RecruitmentEvaluation[]

  @@index([isActive])
  @@index([lockedUntil])
}

model AuthIdentity {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @db.Uuid
  provider        AuthProvider
  providerSubject String
  email           String?
  profilePhotoUrl String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model LoginVerificationCode {
  id                String                  @id @default(uuid()) @db.Uuid
  userId            String                  @db.Uuid
  method            LoginVerificationMethod
  /// LOGIN for sign-in codes; an action key (e.g. recruitment.close) for a code confirming one sensitive action.
  /// Kept apart so neither kind of code can stand in for the other.
  purpose           String                  @default("LOGIN")
  codeHash          String
  expiresAt         DateTime
  consumedAt        DateTime?
  attempts          Int                     @default(0)
  resendAvailableAt DateTime
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, method, createdAt])
  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

model Role {
  id                  String               @id @default(uuid()) @db.Uuid
  key                 String               @unique
  label               String
  createdAt           DateTime             @default(now())
  users               UserRole[]
  permissions         RolePermission[]
  platformMemberships PlatformMembership[]
  tenantMemberships   TenantMembership[]
}

model Permission {
  id                  String                         @id @default(uuid()) @db.Uuid
  key                 String                         @unique
  label               String
  createdAt           DateTime                       @default(now())
  roles               RolePermission[]
  membershipOverrides MembershipPermissionOverride[]
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  assignedAt   DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model MembershipPermissionOverride {
  tenantId     String           @db.Uuid
  userId       String           @db.Uuid
  permissionId String           @db.Uuid
  granted      Boolean
  assignedAt   DateTime         @default(now())
  membership   TenantMembership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)
  permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([tenantId, userId, permissionId])
  @@index([permissionId])
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  familyId         String    @db.Uuid
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedById     String?   @db.Uuid
  ipAddress        String?
  location         String?
  userAgent        String?
  /// The browser's long-lived login-device cookie: a new sign-in there replaces its previous session.
  deviceId         String?
  lastUsedAt       DateTime?
  /// When this sign-in passed its second step (email/authenticator code, or Google). Until then the
  /// session can only reach the verification endpoints. Kept per session (User.loginVerifiedAt is only a
  /// record), so verifying one browser never unlocks another that only knew the password.
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([userId, deviceId])
  @@index([familyId])
  @@index([expiresAt])
}

model LoginRateLimit {
  id            String    @id @default(uuid()) @db.Uuid
  scope         String
  keyHash       String
  failedCount   Int       @default(0)
  blockedUntil  DateTime?
  lastFailureAt DateTime?
  lastAlertAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([scope, keyHash])
  @@index([blockedUntil])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  tenantId    String?  @db.Uuid
  event       String
  success     Boolean  @default(true)
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([event, createdAt])
  @@index([actorUserId, createdAt])
  @@index([tenantId, createdAt])
}

model IdempotencyRecord {
  id           String   @id @default(uuid()) @db.Uuid
  scopeKey     String
  key          String
  requestHash  String
  statusCode   Int?
  responseBody Json?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([scopeKey, key])
  @@index([expiresAt])
}

model WebhookEvent {
  id              String        @id @default(uuid()) @db.Uuid
  platformId      String        @db.Uuid
  tenantId        String?       @db.Uuid
  provider        String
  externalEventId String
  eventType       String
  payload         Json
  status          WebhookStatus @default(RECEIVED)
  attempts        Int           @default(0)
  receivedAt      DateTime      @default(now())
  processedAt     DateTime?
  lastError       String?
  platform        Platform      @relation(fields: [platformId], references: [id], onDelete: Cascade)
  tenant          Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([platformId, provider, externalEventId])
  @@index([tenantId, status])
  @@index([status, receivedAt])
}

enum PromoStudentRole {
  DELEGATE
  CO_DELEGATE
}

/// A class roster (promo), identified by the year it entered the programme: 2026 = promo 2026-2029.
model PromoList {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @db.Uuid
  startYear Int
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  students  PromoListStudent[]

  @@unique([tenantId, startYear])
}

model PromoListStudent {
  id            String            @id @default(uuid()) @db.Uuid
  promoListId   String            @db.Uuid
  position      Int
  fullName      String
  studentNumber String?
  email         String?
  role          PromoStudentRole?
  promoList     PromoList         @relation(fields: [promoListId], references: [id], onDelete: Cascade)

  @@index([promoListId, position])
}

/// Club announcement shown to members and/or staff. One page can carry a poll, a wheel of
/// names, reactions and an RSVP. Stickers are decorations placed on the cover
/// ([{ key, x, y, size, rotate }], x/y in % of the cover).
model ClubAnnouncement {
  id               String                     @id @default(uuid()) @db.Uuid
  tenantId         String                     @db.Uuid
  title            String
  body             String                     @default("")
  /// Cover colour theme key (frontend palette).
  theme            String                     @default("ocean")
  stickers         Json                       @default("[]")
  /// Photos, videos (Cloudinary) and links shown under the message: [{ kind, url, objectKey?, title? }].
  attachments      Json                       @default("[]")
  /// ALL (members and staff), MEMBERS or STAFF.
  audience         String                     @default("ALL")
  /// Members of one track only (e.g. ilisi-2); null = every track.
  audienceTrack    String?
  pinned           Boolean                    @default(false)
  publishedAt      DateTime?
  expiresAt        DateTime?
  pollQuestion     String?
  pollOptions      String[]                   @default([])
  pollMultiple     Boolean                    @default(false)
  pollClosesAt     DateTime?
  wheelTitle       String?
  wheelEntries     String[]                   @default([])
  wheelResult      String?
  wheelSpunAt      DateTime?
  reactionsEnabled Boolean                    @default(true)
  rsvpEnabled      Boolean                    @default(false)
  eventAt          DateTime?
  eventPlace       String?
  /// The activity this announcement was made for (from the activity's notification dialog), if any.
  activityId       String?                    @db.Uuid
  createdBy        String                     @db.Uuid
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  tenant           Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  votes            ClubAnnouncementVote[]
  reactions        ClubAnnouncementReaction[]
  rsvps            ClubAnnouncementRsvp[]

  @@index([tenantId, publishedAt])
}

model ClubAnnouncementVote {
  id             String           @id @default(uuid()) @db.Uuid
  announcementId String           @db.Uuid
  userId         String           @db.Uuid
  option         Int
  createdAt      DateTime         @default(now())
  announcement   ClubAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId, option])
}

model ClubAnnouncementReaction {
  id             String           @id @default(uuid()) @db.Uuid
  announcementId String           @db.Uuid
  userId         String           @db.Uuid
  emoji          String
  createdAt      DateTime         @default(now())
  announcement   ClubAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId, emoji])
}

model ClubAnnouncementRsvp {
  id             String           @id @default(uuid()) @db.Uuid
  announcementId String           @db.Uuid
  userId         String           @db.Uuid
  going          Boolean
  updatedAt      DateTime         @updatedAt
  announcement   ClubAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
}

/// One email the app sent (never its body: it may hold sign-in codes). `status` follows Resend's
/// delivery events: QUEUED → SENT → DELIVERED, or DELAYED / BOUNCED / COMPLAINED / FAILED.
model EmailLog {
  id         String    @id @default(uuid()) @db.Uuid
  to         String
  subject    String
  /// What the email is for: verification, registration, birthday, invitation…
  kind       String
  status     String    @default("QUEUED")
  /// Resend's id for the email, to match its delivery events.
  providerId String?   @unique
  /// Why it failed or bounced, as reported.
  error      String?
  /// What rebuilds the email to send it again (the send method's input), only for kinds that hold no
  /// code, token or link that expires: welcome, confirmation, requests, birthday, promo-list check.
  resend     Json?
  /// When an admin sent it again from the Emails page (the new attempt is its own row).
  resentAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([createdAt])
  @@index([to])
}

/// One browser that opened the public landing page, known by a random key kept in its localStorage.
model LandingVisitor {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @db.Uuid
  key         String
  firstSeenAt DateTime       @default(now())
  lastSeenAt  DateTime       @default(now())
  visitCount  Int            @default(0)
  /// A club admin's own browser (it opened the Visitors page): left out of the numbers.
  staff       Boolean        @default(false)
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visits      LandingVisit[]

  @@unique([tenantId, key])
  @@index([tenantId, lastSeenAt])
}

/// One opening of the landing page: where from, on what, how long and how far it went.
model LandingVisit {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @db.Uuid
  visitorId   String              @db.Uuid
  /// The visitor's 1st, 2nd… visit.
  number      Int
  ipAddress   String?
  /// ISO 3166 two-letter code.
  country     String?
  region      String?
  city        String?
  /// mobile | tablet | desktop
  device      String
  browser     String?
  os          String?
  language    String?
  /// The referring site's host ("google.com"), null for direct visits.
  referrer    String?
  utmSource   String?
  utmCampaign String?
  screen      String?
  startedAt   DateTime            @default(now())
  lastSeenAt  DateTime            @default(now())
  /// Time the page was actually on screen.
  durationMs  Int                 @default(0)
  /// Deepest scroll, in percent of the page.
  maxScroll   Int                 @default(0)
  /// Section ids seen, in the order they were first seen.
  sections    String[]            @default([])
  clicks      Int                 @default(0)
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visitor     LandingVisitor      @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  events      LandingVisitEvent[]

  @@index([tenantId, startedAt])
  @@index([visitorId, startedAt])
  @@index([tenantId, ipAddress])
}

/// Something a visitor did on the landing page: a section came into view, or a link/button was clicked.
model LandingVisitEvent {
  id       String       @id @default(uuid()) @db.Uuid
  tenantId String       @db.Uuid
  visitId  String       @db.Uuid
  /// section | click
  type     String
  target   String
  /// The section the click happened in.
  section  String?
  at       DateTime     @default(now())
  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visit    LandingVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([tenantId, at])
  @@index([visitId, at])
}

/// Feedback sent from the site's Feedback button (landing page, member space, staff dashboard):
/// a suggestion, a problem, something to remove. Visitors may leave a name and an email; a
/// signed-in sender is linked to their account.
/// One decision of the end-of-year passage for one member. `academicYear` is the year the school year started
/// (2025 = 2025-2026). A member has at most one decision per year, so the history tells who repeated, who left
/// and who graduated.
model ClubProgressionEntry {
  id             String                 @id @default(uuid()) @db.Uuid
  tenantId       String                 @db.Uuid
  registrationId String                 @db.Uuid
  academicYear   Int
  outcome        ClubProgressionOutcome
  fromProgram    String
  toProgram      String?
  reason         String?
  decidedBy      String                 @db.Uuid
  createdAt      DateTime               @default(now())
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registration   ClubRegistration       @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([registrationId, academicYear])
  @@index([tenantId, academicYear, outcome])
}

/// A professor or laureate (alumnus) space. They are not club members (no ClubRegistration) and not staff
/// (no TenantMembership): this row alone gives them their own space.
model ClubSpaceProfile {
  id                  String          @id @default(uuid()) @db.Uuid
  tenantId            String          @db.Uuid
  userId              String?         @db.Uuid
  kind                ClubSpaceKind
  status              ClubSpaceStatus
  firstName           String
  lastName            String
  email               String
  phone               String?
  /// Professor: what they teach. Laureate: not used.
  department          String?
  /// Professor: how to address them ("Pr.", "Dr."…).
  title               String?
  /// Professor invitation (the link emailed to them).
  invitationTokenHash String?         @unique
  invitationExpiresAt DateTime?
  invitedBy           String?         @db.Uuid
  /// Laureate: first year of their promo (2021 = promo 2021-2024), the track and what they do now.
  promoStartYear      Int?
  studyProgram        String?
  currentPosition     String?
  company             String?
  city                String?
  linkedinUrl         String?
  /// Whether other laureates see them in the alumni directory (opt-in).
  directoryVisible    Boolean         @default(false)
  /// Proof of having studied at Ilisi: a photo of the student card, diploma or attestation (private storage).
  proofKind           String?
  proofObjectKey      String?
  proofUploadedAt     DateTime?
  /// Automatic promo-list match { cohort, name, by } found at sign-up; helps staff, never decides.
  rosterMatch         Json?
  /// Set when the club made them a laureate from their member registration (end-of-year graduation).
  registrationId      String?         @db.Uuid
  /// Lets the sign-up form send the proof right after the profile exists.
  trackingTokenHash   String?         @unique
  emailVerifiedAt     DateTime?
  reviewedAt          DateTime?
  reviewedBy          String?         @db.Uuid
  rejectionReason     String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([tenantId, userId, kind])
  @@index([tenantId, kind, status])
  @@index([tenantId, email])
  @@index([userId])
}

model ClubFeedback {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  /// Who sent it: STUDENT | TEACHER | ALUMNI | PARTNER | OTHER
  role       String    @default("OTHER")
  /// SUGGESTION | PROBLEM | REMOVE | OTHER
  kind       String
  message    String
  name       String?
  email      String?
  userId     String?   @db.Uuid
  /// Where it was sent from: landing | member | staff
  source     String
  /// A visitor's address, for the per-sender limit (signed-in senders are counted by account).
  ipAddress  String?
  /// The page it was sent from ("/", "/member/activities"…).
  page       String?
  /// Up to three attached images (Cloudinary public ids, read through signed URLs).
  images     String[]  @default([])
  /// The visitor's browser key (landing tracker): tells repeat messages from one person apart.
  visitorKey String?
  /// NEW | DONE
  status     String    @default("NEW")
  createdAt  DateTime  @default(now())
  handledAt  DateTime?
  handledBy  String?   @db.Uuid
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt])
  @@index([ipAddress, createdAt])
  @@index([userId, createdAt])
}

enum ClubProjectKind {
  /// Paid work for a client: the revenue is shared between the club and the team.
  COMMERCIAL
  /// A school project: no money to share.
  ACADEMIC
}

enum ClubProjectStatus {
  PLANNED
  ACTIVE
  DONE
  CANCELLED
}

/// A club project. Commercial ones carry a team with a role and a share of the revenue each, plus the club's own share
/// (percentages are stored in basis points: 2500 = 25 %).
model ClubProject {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @db.Uuid
  kind         ClubProjectKind
  title        String
  description  String?
  /// The client (commercial) or the supervisor / school (academic).
  partner      String?
  status       ClubProjectStatus  @default(PLANNED)
  startsAt     DateTime?
  endsAt       DateTime?
  /// What the client pays, in minor units (commercial only); the shares are computed from it.
  revenueMinor Int?
  currency     String             @default("MAD")
  /// The club's share of the revenue, in basis points (commercial only).
  clubShareBp  Int                @default(0)
  createdBy    String             @db.Uuid
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  team         ClubProjectMember[]

  @@index([tenantId, kind, status])
}

/// Someone on a project team: a club member or an outside person, with their role and share (basis points of the revenue).
model ClubProjectMember {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @db.Uuid
  projectId      String            @db.Uuid
  registrationId String?           @db.Uuid
  name           String
  role           String
  shareBp        Int               @default(0)
  createdAt      DateTime          @default(now())
  project        ClubProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  registration   ClubRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([registrationId])
}

/// A phone that signed in to the mobile app and agreed to notifications (Expo push token).
model PushDevice {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// How serious an alert is: its colour on the banner (blue, violet, amber, red, green).
enum ClubAlertKind {
  INFO
  UPDATE
  WARNING
  ERROR
  SUCCESS
}

/// An alert the club shows as a banner at the top of every page of the chosen spaces, until it ends, the club
/// closes it for everyone, or the person closes it (when allowed). The details (text, images, a video link,
/// buttons) open in a dialog.
model ClubAlert {
  id               String         @id @default(uuid()) @db.Uuid
  tenantId         String         @db.Uuid
  kind             ClubAlertKind  @default(INFO)
  /// A sticker key of the frontend (CalendarStickerKey), drawn on the banner.
  sticker          String?
  title            String
  message          String
  /// The longer text of the details dialog.
  details          String         @default("")
  /// [{ kind: IMAGE | VIDEO, url, objectKey? }]: uploaded images, video links (YouTube, Vimeo, Drive…).
  media            Json           @default("[]")
  /// [{ label, url }]: buttons on the banner and in the details.
  links            Json           @default("[]")
  /// MEMBERS, ALUMNI, PROFESSORS, STAFF.
  audiences        String[]
  /// Members only: tracks (empty = all), picked registrations (empty = no hand-picked list), age and member-since bounds.
  memberTracks     String[]       @default([])
  memberIds        String[]       @default([]) @db.Uuid
  memberAgeMin     Int?
  memberAgeMax     Int?
  memberSinceFrom  DateTime?
  memberSinceTo    DateTime?
  /// People (accounts) who never see it, whatever the rest says.
  excludedUserIds  String[]       @default([]) @db.Uuid
  /// The close button on the banner; off = it stays until it ends or the club closes it.
  dismissible      Boolean        @default(true)
  /// An "I've read it" button that records who confirmed.
  requireAck       Boolean        @default(false)
  /// Stays fixed at the top of the page while scrolling (off = scrolls away with the page).
  sticky           Boolean        @default(true)
  /// Also sent as a push notification to the mobile app, when it starts.
  push             Boolean        @default(false)
  pushSentAt       DateTime?
  startsAt         DateTime       @default(now())
  endsAt           DateTime?
  /// Closed by the club for everyone.
  closedAt         DateTime?
  closedBy         String?        @db.Uuid
  createdBy        String         @db.Uuid
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receipts         ClubAlertReceipt[]

  @@index([tenantId, startsAt])
}

/// What one person did with an alert: when they first saw it, closed it, or confirmed they read it.
model ClubAlertReceipt {
  alertId        String    @db.Uuid
  userId         String    @db.Uuid
  seenAt         DateTime  @default(now())
  dismissedAt    DateTime?
  acknowledgedAt DateTime?
  alert          ClubAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@id([alertId, userId])
  @@index([userId])
}
