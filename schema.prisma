// Tenant domain changes require reviewed, data-preserving migrations under prisma/migrations. SITE XPLORE
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum MemberRegistrationSource {
  WALK_IN
  REFERRAL
  SOCIAL_MEDIA
  WEBSITE
  PARTNER
  ADVERTISEMENT
  OTHER
}

enum MemberSubscriptionStatus {
  SCHEDULED
  ACTIVE
  TRANSFERRED
  EXPIRED
  CANCELED
}

enum MemberContactMode {
  SELF
  RESPONSIBLE_PERSON
}

enum AttendanceDirection {
  ENTRY
  EXIT
}

enum FinanceEntryType {
  INCOME
  EXPENSE
}

enum FinancePaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum BackgroundJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum WebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum AuthProvider {
  PASSWORD
  GOOGLE
  MICROSOFT
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REFUSED
}

enum LoginVerificationMethod {
  EMAIL
  TOTP
}

enum ClubRegistrationStatus {
  PENDING_PAYMENT
  PAYMENT_SUBMITTED
  ACTIVE
  PAYMENT_REJECTED
  CANCELLED
  INACTIVE
  LEFT
}

enum ClubPaymentStatus {
  NOT_SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PARTIALLY_PAID
}

/// Who a club space profile is for: a teacher invited by the club, or a laureate (alumnus) who signed up.
enum ClubSpaceKind {
  PROFESSOR
  ALUMNI
}

enum ClubSpaceStatus {
  /// Professor invited, not accepted yet.
  INVITED
  /// Laureate signed up, waiting for staff to check the proof.
  PENDING_REVIEW
  ACTIVE
  REJECTED
  DISABLED
}

/// What happened to a member at the end of a school year.
enum ClubProgressionOutcome {
  /// Moved up to the next year (Ilisi 1 to 2, 2 to 3).
  PROMOTED
  /// Redoublant: stays in the same year.
  REPEATED
  /// Quit the programme.
  LEFT
  /// Finished Ilisi 3: becomes a laureate.
  GRADUATED
}

enum ClubActivityStatus {
  DRAFT
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// What an activity is: a one-off event (Ramadan evening), a challenge (a game), or a mandatory weekly topic.
enum ClubActivityKind {
  EVENT
  CHALLENGE
  WEEKLY_TOPIC
}

enum ClubActivityRecurrence {
  NONE
  WEEKLY
}

enum ClubActivityOccurrenceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ClubActivityAttendanceStatus {
  PRESENT
  ABSENT
}

enum ClubActivityAbsenceDecision {
  PENDING
  APPROVED
  REJECTED
}

model Platform {
  id            String               @id @default(uuid()) @db.Uuid
  key           String               @unique
  name          String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  tenants       Tenant[]
  admins        PlatformMembership[]
  plans         Plan[]
  modules       Module[]
  webhookEvents WebhookEvent[]
  invitations   PlatformInvitation[]
}

model AccessRequest {
  id           String              @id @default(uuid()) @db.Uuid
  name         String
  gymName      String
  email        String
  phone        String
  description  String
  status       AccessRequestStatus @default(PENDING)
  decidedBy    String?             @db.Uuid
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model Tenant {
  id                             String                          @id @default(uuid()) @db.Uuid
  platformId                     String                          @db.Uuid
  slug                           String
  name                           String
  status                         TenantStatus                    @default(ACTIVE)
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  platform                       Platform                        @relation(fields: [platformId], references: [id], onDelete: Restrict)
  sites                          Site[]
  memberships                    TenantMembership[]
  modules                        TenantModule[]
  settings                       TenantSetting[]
  promoLists                     PromoList[]
  branding                       TenantBranding?
  subscriptions                  TenantSubscription[]
  auditLogs                      AuditLog[]
  members                        Member[]
  webhookEvents                  WebhookEvent[]
  memberSubscriptions            MemberSubscription[]
  subscriptionSnapshots          SubscriptionSnapshot[]
  subscriptionPayments           SubscriptionPayment[]
  serviceAllowanceBalances       ServiceAllowanceBalance[]
  memberInsuranceCoverages       MemberInsuranceCoverage[]
  subscriptionTransferRecords    SubscriptionTransferRecord[]
  attendanceEvents               AttendanceEvent[]
  financeEntries                 FinanceEntry[]
  employees                      Employee[]
  notifications                  Notification[]
  quotas                         TenantQuota[]
  usageMetrics                   UsageMetric[]
  backgroundJobs                 BackgroundJob[]
  invitations                    TenantInvitation[]
  catalogServices                CatalogService[]
  catalogPacks                   CatalogPack[]
  catalogPackServices            CatalogPackService[]
  catalogOffers                  CatalogOffer[]
  catalogOfferAllowances         CatalogOfferAllowance[]
  catalogFees                    CatalogFee[]
  catalogFeeEligibleOffers       CatalogFeeEligibleOffer[]
  catalogInsurances              CatalogInsurance[]
  catalogInsuranceEligibleOffers CatalogInsuranceEligibleOffer[]
  catalogPromotions              CatalogPromotion[]
  catalogPromotionEligibleOffers CatalogPromotionEligibleOffer[]
  clubConfiguration              ClubConfiguration?
  clubRuleVersions               ClubRuleVersion[]
  clubRegistrations              ClubRegistration[]
  clubBirthdayGifts              ClubBirthdayGift[]
  clubAnnouncements              ClubAnnouncement[]
  clubRegistrationPayments       ClubRegistrationPayment[]
  clubAttendanceEvents           ClubAttendanceEvent[]
  clubActivities                 ClubActivity[]
  clubActivityOccurrences        ClubActivityOccurrence[]
  clubActivityParts              ClubActivityPart[]
  clubActivityPartMembers        ClubActivityPartMember[]
  clubActivityMembers            ClubActivityMember[]
  clubActivityAttendance         ClubActivityAttendance[]
  clubActivityFeedback           ClubActivityFeedback[]
  clubActivityQrSessions         ClubActivityQrSession[]
  landingVisitors                LandingVisitor[]
  feedback                       ClubFeedback[]
  spaceProfiles                  ClubSpaceProfile[]
  progressionEntries             ClubProgressionEntry[]
  contributionPrograms           ClubContributionProgram[]
  contributionPayments           ClubContributionPayment[]
  projects                       ClubProject[]
  alerts                         ClubAlert[]
  topicSubjects                  ClubTopicSubject[]
  wheelDraws                     ClubWheelDraw[]
  landingVisits                  LandingVisit[]
  landingVisitEvents             LandingVisitEvent[]
  recruitmentTeams               RecruitmentTeam[]
  recruitmentCampaigns           RecruitmentCampaign[]
  recruitmentCandidates          RecruitmentCandidate[]
  memberXpEntries                MemberXpEntry[]
  memberBadges                   MemberBadge[]

  @@unique([platformId, slug])
  @@index([platformId, status])
}

model ClubConfiguration {
  tenantId             String   @id @db.Uuid
  registrationFeeMinor Int
  trackFees            Json     @default("{}")
  activities           Json     @default("[]")
  landing              Json     @default("{}")
  currency             String   @default("MAD")
  activeRulesVersion   String
  paymentInstructions  String
  /// Who is told about a member's birthday: CLUB (everyone), PROGRAM (same track) or OFF.
  birthdayAudience     String   @default("CLUB")
  updatedAt            DateTime @updatedAt
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// A virtual gift sent to a member for their birthday. Special gifts cost club points:
/// `points` move from the sender to the receiver.
model ClubBirthdayGift {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @db.Uuid
  fromRegistrationId String           @db.Uuid
  toRegistrationId   String           @db.Uuid
  giftKey            String
  points             Int              @default(0)
  message            String?
  /// The birthday it was sent for (YYYY-MM-DD, Casablanca).
  birthdayDate       String
  createdAt          DateTime         @default(now())
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  from               ClubRegistration @relation("BirthdayGiftSender", fields: [fromRegistrationId], references: [id], onDelete: Cascade)
  to                 ClubRegistration @relation("BirthdayGiftReceiver", fields: [toRegistrationId], references: [id], onDelete: Cascade)

  @@unique([fromRegistrationId, toRegistrationId, birthdayDate, giftKey])
  @@index([tenantId, toRegistrationId, createdAt])
  @@index([fromRegistrationId])
}

model ClubRuleVersion {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @db.Uuid
  version       String
  title         String
  content       String
  publishedAt   DateTime           @default(now())
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registrations ClubRegistration[]

  @@unique([tenantId, version])
  @@index([tenantId, publishedAt])
}

model ClubRegistration {
  id                         String                    @id @default(uuid()) @db.Uuid
  tenantId                   String                    @db.Uuid
  userId                     String?                   @db.Uuid
  reference                  String                    @unique
  trackingTokenHash          String                    @unique
  firstName                  String
  lastName                   String
  email                      String
  phone                      String
  studyProgram               String
  cellule                    String?
  studentNumber              String?
  /// Required for new public registrations; older rows may still be missing it.
  dateOfBirth                DateTime?                 @db.Date
  /// Staff link to a student of an official promo list (start year + full name as on the
  /// list), for names the automatic matching can't recognise.
  rosterCohort               Int?
  rosterName                 String?
  /// Year the birthday email was last sent, so the daily job greets each student once a year.
  birthdayGreetedYear        Int?
  hasStudentCard             Boolean                   @default(false)
  studentCardObjectKey       String?
  photoObjectKey             String?
  emailVerifiedAt            DateTime?
  studentCardUploadedAt      DateTime?
  activities                 String[]                  @default([])
  feeMinor                   Int
  paidMinor                  Int                       @default(0)
  currency                   String
  acceptedRulesVersion       String
  rulesAcceptedAt            DateTime
  status                     ClubRegistrationStatus    @default(PENDING_PAYMENT)
  paymentStatus              ClubPaymentStatus         @default(NOT_SUBMITTED)
  paymentReference           String?
  paymentSubmittedAt         DateTime?
  paymentReviewedAt          DateTime?
  paymentReviewedBy          String?                   @db.Uuid
  rejectionReason            String?
  qrTokenHash                String?                   @unique
  qrIssuedAt                 DateTime?
  qrRevokedAt                DateTime?
  statusReason               String?
  statusChangedAt            DateTime?
  statusChangedBy            String?                   @db.Uuid
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  tenant                     Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                       User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  ruleVersion                ClubRuleVersion           @relation(fields: [tenantId, acceptedRulesVersion], references: [tenantId, version], onDelete: Restrict)
  recruitmentCandidates      RecruitmentCandidate[]
  attendanceEvents           ClubAttendanceEvent[]
  activityMemberships        ClubActivityMember[]
  activityPartMemberships    ClubActivityPartMember[]
  activityAttendance         ClubActivityAttendance[]
  activityFeedback           ClubActivityFeedback[]
  payments                   ClubRegistrationPayment[]
  /// Staff check of the uploaded student card: PENDING (to check), VERIFIED or REJECTED.
  studentCardStatus          String?
  studentCardReviewedAt      DateTime?
  studentCardReviewedBy      String?                   @db.Uuid
  /// Why staff refused the photo (shown to the student so they can send a new one).
  studentCardRejectionReason String?
  /// Automatic check the student's browser ran on the card ({ passed, issues, checkedAt }); helps staff, never decides.
  studentCardAutoCheck       Json?
  /// Staff check of the member's profile photo (their account photo): PENDING (changed, to check),
  /// VERIFIED, REJECTED (removed, a new one is needed) or UPDATE_REQUESTED (staff ask for one).
  photoStatus                String?
  photoSubmittedAt           DateTime?
  photoReviewedAt            DateTime?
  photoReviewedBy            String?                   @db.Uuid
  /// Refusal reason or staff request message, shown to the member.
  photoReviewMessage         String?
  /// Automatic check of the current profile photo (face found…), same shape as studentCardAutoCheck.
  photoAutoCheck             Json?
  /// Once staff VERIFIED the photo it is locked: the member sends the new one here, staff approve
  /// it (it becomes the account photo) or refuse it. Empty when no change is waiting.
  photoChangeUrl             String?
  photoChangePublicId        String?
  photoChangeRequestedAt     DateTime?
  photoChangeMessage         String?
  /// Automatic check of the photo waiting in photoChangeUrl.
  photoChangeAutoCheck       Json?
  /// Why staff refused the last change request (shown to the member until their next request).
  photoChangeRejection       String?
  /// Personal details staff asked the member to correct (name, phone, dateOfBirth, studentNumber).
  /// Empty when nothing is pending; cleared once the member sends them.
  infoRequestFields          String[]                  @default([])
  infoRequestMessage         String?
  infoRequestedAt            DateTime?
  infoRequestedBy            String?                   @db.Uuid
  /// Details the member corrected (on their own or answering infoRequest), waiting for staff:
  /// { firstName?, lastName?, phone?, dateOfBirth? (YYYY-MM-DD), studentNumber? }. Applied only once
  /// staff accept them; null when nothing is waiting.
  infoChange                 Json?
  infoChangeRequestedAt      DateTime?
  /// Why staff refused the last correction (shown to the member until their next one).
  infoChangeRejection        String?
  /// Last time the member opened their notifications (for the unread badge).
  notificationsSeenAt        DateTime?
  /// Earned stickers the member has already seen in their album (the others show as new).
  stickersSeen               String[]                  @default([])
  /// Up to 3 earned stickers the member shows on their profile.
  favoriteStickers           String[]                  @default([])
  birthdayGiftsSent          ClubBirthdayGift[]        @relation("BirthdayGiftSender")
  birthdayGiftsReceived      ClubBirthdayGift[]        @relation("BirthdayGiftReceiver")
  progressionEntries         ClubProgressionEntry[]
  projectRoles               ClubProjectMember[]
  contributionPayments       ClubContributionPayment[]
  wheelDraws                 ClubWheelDraw[]

  @@unique([tenantId, userId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, paymentStatus, createdAt])
  @@index([tenantId, email])
  @@index([tenantId, studentNumber])
  @@index([tenantId, phone])
  @@index([userId])
}

/// 6-digit email code for public registration; a verified code issues a single-use token.
model ClubEmailVerification {
  id         String    @id @default(uuid()) @db.Uuid
  email      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  tokenHash  String?   @unique
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

/// One instalment towards a registration fee (taken at the club).
model ClubRegistrationPayment {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @db.Uuid
  registrationId String               @db.Uuid
  amountMinor    Int
  currency       String
  method         FinancePaymentMethod
  reference      String?
  recordedBy     String?              @db.Uuid
  financeEntryId String?              @db.Uuid
  paidAt         DateTime
  createdAt      DateTime             @default(now())
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registration   ClubRegistration     @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId, paidAt])
  @@index([tenantId, paidAt])
}

model ClubAttendanceEvent {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  registrationId String           @db.Uuid
  staffUserId    String           @db.Uuid
  checkInDate    DateTime         @db.Date
  scannedAt      DateTime         @default(now())
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registration   ClubRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([registrationId, checkInDate])
  @@index([tenantId, scannedAt])
}

model ClubActivity {
  id                   String                   @id @default(uuid()) @db.Uuid
  tenantId             String                   @db.Uuid
  title                String
  description          String?
  type                 String
  language             String
  recurrence           ClubActivityRecurrence   @default(NONE)
  weekday              Int?
  startTime            String
  timezone             String
  startsAt             DateTime?
  absencePenaltyPoints Int                      @default(0)
  status               ClubActivityStatus       @default(WAITING)
  kind                 ClubActivityKind         @default(EVENT)
  /// Tracks whose active members take part automatically (a member who moves to or joins one of them is added, one who
  /// moves out is removed); members added by hand stay whatever their track.
  audienceTracks       String[]                 @default([])
  /// Whether a QR code can be shown for this activity's sessions.
  qrEnabled            Boolean                  @default(true)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  tenant               Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  occurrences          ClubActivityOccurrence[]
  members              ClubActivityMember[]
  contribution         ClubContributionProgram?
  topicSubjects        ClubTopicSubject[]
  wheelDraws           ClubWheelDraw[]

  @@index([tenantId, status, createdAt])
  @@index([tenantId, startsAt])
}

/// The cotisation an activity asks of each participant (one program per activity). Staff record what each one paid.
model ClubContributionProgram {
  id          String                    @id @default(uuid()) @db.Uuid
  tenantId    String                    @db.Uuid
  activityId  String                    @unique @db.Uuid
  amountMinor Int
  currency    String
  dueAt       DateTime?
  notes       String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  tenant      Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activity    ClubActivity              @relation(fields: [activityId], references: [id], onDelete: Cascade)
  payments    ClubContributionPayment[]

  @@index([tenantId])
}

/// A payment (partial ones add up) or a waiver (the member owes nothing) recorded by staff.
model ClubContributionPayment {
  id             String                  @id @default(uuid()) @db.Uuid
  tenantId       String                  @db.Uuid
  programId      String                  @db.Uuid
  registrationId String                  @db.Uuid
  amountMinor    Int
  method         FinancePaymentMethod    @default(CASH)
  reference      String?
  note           String?
  waived         Boolean                 @default(false)
  paidAt         DateTime                @default(now())
  recordedBy     String                  @db.Uuid
  createdAt      DateTime                @default(now())
  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program        ClubContributionProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  registration   ClubRegistration        @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([programId, registrationId])
  @@index([tenantId, registrationId])
}

/// A subject of a weekly topic's bank. Subjects are drawn lowest level first: level 2 only comes up once every level-1
/// subject has been drawn. A drawn subject is not drawn again.
model ClubTopicSubject {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @db.Uuid
  activityId  String          @db.Uuid
  title       String
  description String?
  level       Int             @default(1)
  drawnAt     DateTime?
  createdAt   DateTime        @default(now())
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activity    ClubActivity    @relation(fields: [activityId], references: [id], onDelete: Cascade)
  draws       ClubWheelDraw[]

  @@index([activityId, level])
}

/// One spin of a weekly topic's wheel: a participant and a subject, for one session. `cycle` counts the rounds: a
/// participant is drawn once per round, and a new round starts when everyone has been drawn.
model ClubWheelDraw {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  activityId     String           @db.Uuid
  occurrenceId   String?          @db.Uuid
  registrationId String           @db.Uuid
  subjectId      String           @db.Uuid
  /// The topic created in the session (so it shows in the usual place); removed when the draw is cancelled.
  partId         String?          @db.Uuid
  cycle          Int
  drawnBy        String           @db.Uuid
  createdAt      DateTime         @default(now())
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activity       ClubActivity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  registration   ClubRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  subject        ClubTopicSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([activityId, cycle])
  @@index([tenantId, registrationId])
}

model ClubActivityOccurrence {
  id                String                       @id @default(uuid()) @db.Uuid
  tenantId          String                       @db.Uuid
  activityId        String                       @db.Uuid
  startsAt          DateTime
  endsAt            DateTime?
  status            ClubActivityOccurrenceStatus @default(SCHEDULED)
  presentationNotes String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  tenant            Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activity          ClubActivity                 @relation(fields: [activityId], references: [id], onDelete: Cascade)
  parts             ClubActivityPart[]
  attendance        ClubActivityAttendance[]
  feedback          ClubActivityFeedback[]
  qrSessions        ClubActivityQrSession[]

  @@unique([activityId, startsAt])
  @@index([tenantId, startsAt, status])
}

model ClubActivityPart {
  id           String                   @id @default(uuid()) @db.Uuid
  tenantId     String                   @db.Uuid
  occurrenceId String                   @db.Uuid
  position     Int
  title        String
  description  String?
  notes        String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  tenant       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  occurrence   ClubActivityOccurrence   @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  feedback     ClubActivityFeedback[]
  members      ClubActivityPartMember[]

  @@unique([occurrenceId, position])
  @@index([tenantId, occurrenceId, position])
}

model ClubActivityPartMember {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  partId         String           @db.Uuid
  registrationId String           @db.Uuid
  assignedAt     DateTime         @default(now())
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  part           ClubActivityPart @relation(fields: [partId], references: [id], onDelete: Cascade)
  registration   ClubRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([partId, registrationId])
  @@index([tenantId, registrationId])
  @@index([tenantId, partId])
}

model ClubActivityMember {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  activityId     String           @db.Uuid
  registrationId String           @db.Uuid
  assignedAt     DateTime         @default(now())
  /// MANUAL (picked by staff) or TRACK (added by the activity's audienceTracks).
  source         String           @default("MANUAL")
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activity       ClubActivity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  registration   ClubRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([activityId, registrationId])
  @@index([tenantId, registrationId])
}

model ClubActivityAttendance {
  id              String                       @id @default(uuid()) @db.Uuid
  tenantId        String                       @db.Uuid
  occurrenceId    String                       @db.Uuid
  registrationId  String                       @db.Uuid
  status          ClubActivityAttendanceStatus
  absenceReason   String?
  absenceDecision ClubActivityAbsenceDecision  @default(PENDING)
  penaltyPoints   Int                          @default(0)
  markedAt        DateTime                     @default(now())
  decidedAt       DateTime?
  decidedBy       String?                      @db.Uuid
  tenant          Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  occurrence      ClubActivityOccurrence       @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  registration    ClubRegistration             @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([occurrenceId, registrationId])
  @@index([tenantId, occurrenceId, status])
  @@index([tenantId, registrationId])
}

model ClubActivityFeedback {
  id                   String                 @id @default(uuid()) @db.Uuid
  tenantId             String                 @db.Uuid
  occurrenceId         String                 @db.Uuid
  partId               String                 @db.Uuid
  registrationId       String                 @db.Uuid
  understandingPercent Int
  comment              String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  occurrence           ClubActivityOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  part                 ClubActivityPart       @relation(fields: [partId], references: [id], onDelete: Cascade)
